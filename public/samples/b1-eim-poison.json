{"id":"sample_b1-eim-poison","videoId":"TEfLTDq9Td8","title":"English in a Minute: To Poison the Well","author":"VOA Learning English","videoDuration":60000,"lang":"en","transcriptHash":"25e187d39b3d9b49df5b40f32363783f","source":"supadata","start":0,"end":59000,"sentences":[{"id":"s0_0","text":"Welcome to English in a Minute.","words":[{"w":"Welcome","start":0,"end":1163},{"w":"to","start":1163,"end":1600},{"w":"English","start":1600,"end":2763},{"w":"in","start":2763,"end":3199},{"w":"a","start":3199,"end":3490},{"w":"Minute.","start":3490,"end":4508}],"start":0,"end":4508,"timing":"estimated","chunks":[0,1],"chunksByAi":true,"ja":"イングリッシュ・イン・ア・ミニットへようこそ","edge":false,"segFrom":0,"segTo":0},{"id":"s1_4508","text":"People get their drinking water from a well.","words":[{"w":"People","start":4508,"end":5526},{"w":"get","start":5526,"end":6107},{"w":"their","start":6107,"end":6980},{"w":"drinking","start":6980,"end":8288},{"w":"water","start":8288,"end":9161},{"w":"from","start":9161,"end":9888},{"w":"a","start":9888,"end":10179},{"w":"well.","start":10179,"end":10906}],"start":4508,"end":10906,"timing":"estimated","chunks":[0,2,5],"chunksByAi":true,"ja":"人は井戸から飲み水を得ます","edge":false,"segFrom":0,"segTo":0},{"id":"s2_10906","text":"So adding poison to it would be a terrible thing to do.","words":[{"w":"So","start":10906,"end":11342},{"w":"adding","start":11342,"end":12360},{"w":"poison","start":12360,"end":12934},{"w":"to","start":12934,"end":13179},{"w":"it","start":13179,"end":13425},{"w":"would","start":13425,"end":13917},{"w":"be","start":13917,"end":14163},{"w":"a","start":14163,"end":14326},{"w":"terrible","start":14326,"end":15064},{"w":"thing","start":15064,"end":15555},{"w":"to","start":15555,"end":15801},{"w":"do.","start":15801,"end":16047}],"start":10906,"end":16047,"timing":"estimated","chunks":[0,3,5,7,10],"chunksByAi":true,"ja":"だから、毒を入れるのはひどいことです","edge":false,"segFrom":0,"segTo":1},{"id":"s3_16047","text":"But what does the idiom \"to Poison the Well\" mean?","words":[{"w":"But","start":16047,"end":16375},{"w":"what","start":16375,"end":16785},{"w":"does","start":16785,"end":17194},{"w":"the","start":17194,"end":17522},{"w":"idiom","start":17522,"end":18014},{"w":"\"to","start":18014,"end":18259},{"w":"Poison","start":18259,"end":18833},{"w":"the","start":18833,"end":19161},{"w":"Well\"","start":19161,"end":19570},{"w":"mean?","start":19570,"end":19980}],"start":16047,"end":19980,"timing":"estimated","chunks":[0,3,5,9],"chunksByAi":true,"ja":"しかし、「井戸に毒を入れる」という慣用句は何の意味ですか？","edge":false,"segFrom":1,"segTo":1},{"id":"s4_20640","text":"My old roommate opened a new restaurant, Pat's Perfect Pizza Palace.","words":[{"w":"My","start":20640,"end":20894},{"w":"old","start":20894,"end":21233},{"w":"roommate","start":21233,"end":21997},{"w":"opened","start":21997,"end":22590},{"w":"a","start":22590,"end":22760},{"w":"new","start":22760,"end":23099},{"w":"restaurant,","start":23099,"end":24031},{"w":"Pat's","start":24031,"end":24540},{"w":"Perfect","start":24540,"end":25218},{"w":"Pizza","start":25218,"end":25727},{"w":"Palace.","start":25727,"end":26320}],"start":20640,"end":26320,"timing":"estimated","chunks":[0,3,7],"chunksByAi":true,"ja":"私の元ルームメイトが新しいレストランを開きました、パッツ・パーフェクト・ピザ・パレス","edge":false,"segFrom":2,"segTo":2},{"id":"s5_26320","text":"Oh my gosh, I'm having my birthday party there.","words":[{"w":"Oh","start":26320,"end":26575},{"w":"my","start":26575,"end":26829},{"w":"gosh,","start":26829,"end":27253},{"w":"I'm","start":27253,"end":27592},{"w":"having","start":27592,"end":28186},{"w":"my","start":28186,"end":28440},{"w":"birthday","start":28440,"end":29234},{"w":"party","start":29234,"end":29763},{"w":"there.","start":29763,"end":30292}],"start":26320,"end":30292,"timing":"estimated","chunks":[0,3,5,8],"chunksByAi":true,"ja":"まあ、私の誕生日パーティーをそこでやるわ","edge":false,"segFrom":2,"segTo":3},{"id":"s6_30292","text":"Bad idea.","words":[{"w":"Bad","start":30292,"end":30645},{"w":"idea.","start":30645,"end":31086}],"start":30292,"end":31086,"timing":"estimated","chunks":[0],"chunksByAi":true,"ja":"悪い考えだ","edge":false,"segFrom":3,"segTo":3},{"id":"s7_31086","text":"Pat was an awful roommate.","words":[{"w":"Pat","start":31086,"end":31439},{"w":"was","start":31439,"end":31791},{"w":"an","start":31791,"end":32056},{"w":"awful","start":32056,"end":32585},{"w":"roommate.","start":32585,"end":33379}],"start":31086,"end":33379,"timing":"estimated","chunks":[0,1],"chunksByAi":true,"ja":"パットはひどいルームメイトだった","edge":false,"segFrom":3,"segTo":3},{"id":"s8_33379","text":"So I'm sure his restaurant will be awful too.","words":[{"w":"So","start":33379,"end":33643},{"w":"I'm","start":33643,"end":33996},{"w":"sure","start":33996,"end":34437},{"w":"his","start":34437,"end":34790},{"w":"restaurant","start":34790,"end":35760},{"w":"will","start":35760,"end":36269},{"w":"be","start":36269,"end":36574},{"w":"awful","start":36574,"end":37185},{"w":"too.","start":37185,"end":37592}],"start":33379,"end":37592,"timing":"estimated","chunks":[0,1,3,5,8],"chunksByAi":true,"ja":"だから彼のレストランもひどいに違いない","edge":false,"segFrom":3,"segTo":4},{"id":"s9_37592","text":"Dan, don't Poison the Well.","words":[{"w":"Dan,","start":37592,"end":37999},{"w":"don't","start":37999,"end":38610},{"w":"Poison","start":38610,"end":39322},{"w":"the","start":39322,"end":39729},{"w":"Well.","start":39729,"end":40238}],"start":37592,"end":40238,"timing":"estimated","chunks":[0,1],"chunksByAi":true,"ja":"ダン、ポイズン・ザ・ウェルをしないで","edge":false,"segFrom":4,"segTo":4},{"id":"s10_40238","text":"It's my birthday.","words":[{"w":"It's","start":40238,"end":40747},{"w":"my","start":40747,"end":41052},{"w":"birthday.","start":41052,"end":41968}],"start":40238,"end":41968,"timing":"estimated","chunks":[0,1],"chunksByAi":true,"ja":"今日は私の誕生日です","edge":false,"segFrom":4,"segTo":4},{"id":"s11_41968","text":"If you Poison the Well, you try to negatively influence how someone feels about something or someone.","words":[{"w":"If","start":41968,"end":42273},{"w":"you","start":42273,"end":42681},{"w":"Poison","start":42681,"end":43393},{"w":"the","start":43393,"end":43800},{"w":"Well,","start":43800,"end":44173},{"w":"you","start":44173,"end":44472},{"w":"try","start":44472,"end":44770},{"w":"to","start":44770,"end":44994},{"w":"negatively","start":44994,"end":45815},{"w":"influence","start":45815,"end":46561},{"w":"how","start":46561,"end":46860},{"w":"someone","start":46860,"end":47457},{"w":"feels","start":47457,"end":47905},{"w":"about","start":47905,"end":48353},{"w":"something","start":48353,"end":49099},{"w":"or","start":49099,"end":49323},{"w":"someone.","start":49323,"end":49920}],"start":41968,"end":49920,"timing":"estimated","chunks":[0,5,7,10,13,15],"chunksByAi":true,"ja":"もしポイズン・ザ・ウェルをすると、何かや誰かについての感情を悪くしようとする","edge":false,"segFrom":4,"segTo":5},{"id":"s12_51000","text":"It often involves trying to damage someone's reputation.","words":[{"w":"It","start":51000,"end":51245},{"w":"often","start":51245,"end":51736},{"w":"involves","start":51736,"end":52472},{"w":"trying","start":52472,"end":53045},{"w":"to","start":53045,"end":53291},{"w":"damage","start":53291,"end":53863},{"w":"someone's","start":53863,"end":54681},{"w":"reputation.","start":54681,"end":55581}],"start":51000,"end":55581,"timing":"estimated","chunks":[0,2,4,6],"chunksByAi":true,"ja":"それはよく誰かの評判を傷つけようとすることです","edge":false,"segFrom":6,"segTo":6},{"id":"s13_55581","text":"And that's English in a minute.","words":[{"w":"And","start":55581,"end":55908},{"w":"that's","start":55908,"end":56481},{"w":"English","start":56481,"end":57135},{"w":"in","start":57135,"end":57381},{"w":"a","start":57381,"end":57544},{"w":"minute.","start":57544,"end":58117}],"start":55581,"end":58117,"timing":"estimated","chunks":[0,2,3],"chunksByAi":true,"ja":"そしてこれが一分間英語です","edge":false,"segFrom":6,"segTo":6}],"segments":[{"text":"[Music] welcome to English in a minute people \nget their drinking water from a well so adding","start":0,"dur":12360},{"text":"poison to it would be a terrible thing to do \nbut what does the idiom to Poison the Well mean","start":12360,"dur":7620},{"text":"my old roommate opened a new restaurant Pat's \nPerfect Pizza Palace oh my gosh I'm having my","start":20640,"dur":7800},{"text":"birthday party there bad idea Pat was an \nawful roommate so I'm sure his restaurant","start":28440,"dur":7320},{"text":"will be awful too Dan don't Poison the Well \nit's my birthday [Music] If You Poison the","start":35760,"dur":8040},{"text":"Well you try to negatively influence how \nsomeone feels about something or someone","start":43800,"dur":6120},{"text":"it often involves trying to damage someone's \nreputation and that's English in a minute [Music]","start":51000,"dur":7117}],"analysisVersion":1,"punctuatedByAi":true,"createdAt":0,"updatedAt":0,"sample":{"level":"B1","topic":"慣用句 poison the well（1 分の解説）","reason":"比ゆ的な慣用句の意味と使い方。会話例が自然な速さに近い（約 118 語/分）","wpm":118,"license":"パブリックドメイン（VOA Learning English）","credit":"VOA Learning English（learningenglish.voanews.com）","sourceUrl":"https://www.youtube.com/watch?v=TEfLTDq9Td8"}}