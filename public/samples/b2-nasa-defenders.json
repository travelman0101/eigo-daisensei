{"id":"sample_b2-nasa-defenders","videoId":"5b3n-u_0QAI","title":"Planetary Defenders: This Is Not an Exercise","author":"NASA","videoDuration":1215000,"lang":"en","transcriptHash":"7c46ea72e0e76c3b1d6150e4d950aecd","source":"supadata","start":118910,"end":242033,"sentences":[{"id":"s0_118910","text":"and then submitted the observations to the Minor Planet Center and went to bed.","words":[{"w":"and","start":118910,"end":119132},{"w":"then","start":119132,"end":119411},{"w":"submitted","start":119411,"end":119967},{"w":"the","start":119967,"end":120189},{"w":"observations","start":120189,"end":120912},{"w":"to","start":120912,"end":121063},{"w":"the","start":121063,"end":121264},{"w":"Minor","start":121264,"end":121565},{"w":"Planet","start":121565,"end":121917},{"w":"Center","start":121917,"end":122269},{"w":"and","start":122269,"end":122470},{"w":"went","start":122470,"end":122721},{"w":"to","start":122721,"end":122872},{"w":"bed.","start":122872,"end":123123}],"start":118910,"end":123123,"timing":"estimated","chunks":[0,2,5,10],"chunksByAi":true,"ja":"そして観測結果を小惑星センターに提出し、寝ました。","edge":false,"segFrom":24,"segTo":25},{"id":"s1_126126","text":"At first, we didn't know it was very significant.","words":[{"w":"At","start":126126,"end":126264},{"w":"first,","start":126264,"end":126585},{"w":"we","start":126585,"end":126722},{"w":"didn't","start":126722,"end":127043},{"w":"know","start":127043,"end":127273},{"w":"it","start":127273,"end":127410},{"w":"was","start":127410,"end":127594},{"w":"very","start":127594,"end":127823},{"w":"significant.","start":127823,"end":128419}],"start":126126,"end":128419,"timing":"line","chunks":[0,2,5],"chunksByAi":true,"ja":"最初は、それがとても重要だとは知りませんでした。","edge":false,"segFrom":26,"segTo":26},{"id":"s2_128419","text":"It was one of several discoveries.","words":[{"w":"It","start":128419,"end":128634},{"w":"was","start":128634,"end":128920},{"w":"one","start":128920,"end":129206},{"w":"of","start":129206,"end":129420},{"w":"several","start":129420,"end":129992},{"w":"discoveries.","start":129992,"end":130922}],"start":128419,"end":130922,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"それはいくつかの発見の一つでした。","edge":false,"segFrom":27,"segTo":27},{"id":"s3_134134","text":"The ATLAS survey, operated by the University of Hawaii, finds about 200 to 250 near-Earth objects per year.","words":[{"w":"The","start":134134,"end":134328},{"w":"ATLAS","start":134328,"end":134618},{"w":"survey,","start":134618,"end":135005},{"w":"operated","start":135005,"end":135441},{"w":"by","start":135441,"end":135586},{"w":"the","start":135586,"end":135780},{"w":"University","start":135780,"end":136312},{"w":"of","start":136312,"end":136458},{"w":"Hawaii,","start":136458,"end":136845},{"w":"finds","start":136845,"end":137370},{"w":"about","start":137370,"end":137894},{"w":"200","start":137894,"end":138244},{"w":"to","start":138244,"end":138506},{"w":"250","start":138506,"end":138856},{"w":"near-Earth","start":138856,"end":139817},{"w":"objects","start":139817,"end":140517},{"w":"per","start":140517,"end":140866},{"w":"year.","start":140866,"end":141391}],"start":134134,"end":141391,"timing":"line","chunks":[0,3,9,14],"chunksByAi":true,"ja":"ハワイ大学が運営するATLAS調査は、毎年200から250個の地球近傍天体を発見します。","edge":false,"segFrom":28,"segTo":29},{"id":"s4_141432","text":"This object was sort of a garden variety new NEO.","words":[{"w":"This","start":141432,"end":141737},{"w":"object","start":141737,"end":142163},{"w":"was","start":142163,"end":142406},{"w":"sort","start":142406,"end":142711},{"w":"of","start":142711,"end":142894},{"w":"a","start":142894,"end":143015},{"w":"garden","start":143015,"end":143442},{"w":"variety","start":143442,"end":143929},{"w":"new","start":143929,"end":144173},{"w":"NEO.","start":144173,"end":144477}],"start":141432,"end":144477,"timing":"line","chunks":[0,3,8],"chunksByAi":true,"ja":"その天体は、普通の新しい近地球天体の一つでした。","edge":false,"segFrom":30,"segTo":30},{"id":"s5_144561","text":"There was nothing about it when we first saw it that suggested that it would be especially dangerous.","words":[{"w":"There","start":144561,"end":144755},{"w":"was","start":144755,"end":144885},{"w":"nothing","start":144885,"end":145144},{"w":"about","start":145144,"end":145339},{"w":"it","start":145339,"end":145436},{"w":"when","start":145436,"end":145653},{"w":"we","start":145653,"end":145783},{"w":"first","start":145783,"end":146043},{"w":"saw","start":146043,"end":146217},{"w":"it","start":146217,"end":146347},{"w":"that","start":146347,"end":146564},{"w":"suggested","start":146564,"end":146998},{"w":"that","start":146998,"end":147215},{"w":"it","start":147215,"end":147345},{"w":"would","start":147345,"end":147605},{"w":"be","start":147605,"end":147735},{"w":"especially","start":147735,"end":148213},{"w":"dangerous.","start":148213,"end":148690}],"start":144561,"end":148690,"timing":"line","chunks":[0,5,10,12],"chunksByAi":true,"ja":"最初にそれを見たとき、特に危険だとは思いませんでした。","edge":false,"segFrom":31,"segTo":32},{"id":"s6_148731","text":"The impact probability climbed.","words":[{"w":"The","start":148731,"end":149106},{"w":"impact","start":149106,"end":149763},{"w":"probability","start":149763,"end":150889},{"w":"climbed.","start":150889,"end":151734}],"start":148731,"end":151734,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"衝突の確率が上がった","edge":false,"segFrom":33,"segTo":33},{"id":"s7_151734","text":"It started to increase with more data.","words":[{"w":"It","start":151734,"end":151930},{"w":"started","start":151930,"end":152452},{"w":"to","start":152452,"end":152648},{"w":"increase","start":152648,"end":153235},{"w":"with","start":153235,"end":153561},{"w":"more","start":153561,"end":153887},{"w":"data.","start":153887,"end":154279}],"start":151734,"end":154279,"timing":"line","chunks":[0,2,4],"chunksByAi":true,"ja":"データが増えるにつれて増え始めた","edge":false,"segFrom":34,"segTo":34},{"id":"s8_154279","text":"That's when things really kind of heated up for us.","words":[{"w":"That's","start":154279,"end":154549},{"w":"when","start":154549,"end":154741},{"w":"things","start":154741,"end":155011},{"w":"really","start":155011,"end":155280},{"w":"kind","start":155280,"end":155473},{"w":"of","start":155473,"end":155588},{"w":"heated","start":155588,"end":155858},{"w":"up","start":155858,"end":155973},{"w":"for","start":155973,"end":156127},{"w":"us.","start":156127,"end":156281}],"start":154279,"end":156281,"timing":"line","chunks":[0,2,6,8],"chunksByAi":true,"ja":"その時が私たちにとって本当に熱くなった時だ","edge":false,"segFrom":35,"segTo":35},{"id":"s9_156281","text":"On December 22nd, 2032, there was a chance that it could impact Earth.","words":[{"w":"On","start":156281,"end":156703},{"w":"December","start":156703,"end":157970},{"w":"22nd,","start":157970,"end":158815},{"w":"2032,","start":158815,"end":159659},{"w":"there","start":159784,"end":160167},{"w":"was","start":160167,"end":160423},{"w":"a","start":160423,"end":160551},{"w":"chance","start":160551,"end":160998},{"w":"that","start":160998,"end":161317},{"w":"it","start":161317,"end":161509},{"w":"could","start":161509,"end":161892},{"w":"impact","start":161892,"end":162340},{"w":"Earth.","start":162340,"end":162787}],"start":156281,"end":162787,"timing":"line","chunks":[0,4,8,12],"chunksByAi":true,"ja":"2032年12月22日、地球に衝突する可能性があった","edge":false,"segFrom":36,"segTo":37},{"id":"s10_164330","text":"From the measurements taken from the ground, 2024 YR4 was estimated to be about 40 to 90 meters in size.","words":[{"w":"From","start":164330,"end":164631},{"w":"the","start":164631,"end":164872},{"w":"measurements","start":164872,"end":165655},{"w":"taken","start":165655,"end":166017},{"w":"from","start":166017,"end":166318},{"w":"the","start":166318,"end":166559},{"w":"ground,","start":166559,"end":167041},{"w":"2024","start":167041,"end":167542},{"w":"YR4","start":167542,"end":167942},{"w":"was","start":167942,"end":168342},{"w":"estimated","start":168342,"end":169343},{"w":"to","start":169343,"end":169644},{"w":"be","start":169644,"end":169944},{"w":"about","start":169944,"end":170545},{"w":"40","start":170545,"end":170845},{"w":"to","start":170845,"end":171145},{"w":"90","start":171145,"end":171445},{"w":"meters","start":171445,"end":172146},{"w":"in","start":172146,"end":172446},{"w":"size.","start":172446,"end":173047}],"start":164330,"end":173047,"timing":"line","chunks":[0,3,7,11,18],"chunksByAi":true,"ja":"地上からの測定から、2024 YR4は40から90メートルの大きさと推定された","edge":false,"segFrom":38,"segTo":39},{"id":"s11_173047","text":"You're talking about an object that could be a city killer.","words":[{"w":"You're","start":173047,"end":173378},{"w":"talking","start":173378,"end":173756},{"w":"about","start":173756,"end":174040},{"w":"an","start":174040,"end":174182},{"w":"object","start":174182,"end":174513},{"w":"that","start":174513,"end":174749},{"w":"could","start":174749,"end":175033},{"w":"be","start":175033,"end":175175},{"w":"a","start":175175,"end":175269},{"w":"city","start":175269,"end":175506},{"w":"killer.","start":175506,"end":175884}],"start":173047,"end":175884,"timing":"line","chunks":[0,2,5,8],"chunksByAi":true,"ja":"都市を壊滅させる可能性のある物体について話している","edge":false,"segFrom":40,"segTo":40},{"id":"s12_175884","text":"It was a large enough size to be dangerous, possibly the size of a jumbo jet.","words":[{"w":"It","start":175884,"end":176026},{"w":"was","start":176026,"end":176216},{"w":"a","start":176216,"end":176310},{"w":"large","start":176310,"end":176595},{"w":"enough","start":176595,"end":176927},{"w":"size","start":176927,"end":177163},{"w":"to","start":177163,"end":177306},{"w":"be","start":177306,"end":177448},{"w":"dangerous,","start":177448,"end":177969},{"w":"possibly","start":177969,"end":178400},{"w":"the","start":178400,"end":178591},{"w":"size","start":178591,"end":178830},{"w":"of","start":178830,"end":178974},{"w":"a","start":178974,"end":179070},{"w":"jumbo","start":179070,"end":179357},{"w":"jet.","start":179357,"end":179596}],"start":175884,"end":179596,"timing":"line","chunks":[0,2,6,9,10,13],"chunksByAi":true,"ja":"それは危険なほど大きなサイズだった、おそらくジャンボジェットのサイズだった。","edge":false,"segFrom":41,"segTo":42},{"id":"s13_179596","text":"Well, if you remember the Chelyabinsk impact of 2013 over Russia, that was estimated to be about a 20 meter asteroid.","words":[{"w":"Well,","start":179596,"end":179979},{"w":"if","start":179979,"end":180170},{"w":"you","start":180170,"end":180426},{"w":"remember","start":180426,"end":181000},{"w":"the","start":181000,"end":181255},{"w":"Chelyabinsk","start":181255,"end":182021},{"w":"impact","start":182021,"end":182468},{"w":"of","start":182468,"end":182659},{"w":"2013","start":182659,"end":182978},{"w":"over","start":182978,"end":183297},{"w":"Russia,","start":183297,"end":183808},{"w":"that","start":183850,"end":184227},{"w":"was","start":184227,"end":184528},{"w":"estimated","start":184528,"end":185282},{"w":"to","start":185282,"end":185508},{"w":"be","start":185508,"end":185735},{"w":"about","start":185735,"end":186187},{"w":"a","start":186187,"end":186338},{"w":"20","start":186338,"end":186564},{"w":"meter","start":186564,"end":187016},{"w":"asteroid.","start":187016,"end":187770}],"start":179596,"end":187770,"timing":"line","chunks":[0,1,4,7,9,11,14,16],"chunksByAi":true,"ja":"2013年のロシア上空のチェリャビンスク衝突を覚えていますか、それは20メートルの小惑星と推定されました。","edge":false,"segFrom":43,"segTo":44},{"id":"s14_188438","text":"Produced a 0.5 megaton amount of energy when it blew up in the sky, and it damaged 7,000 plus buildings and over 1,000 reports of injuries.","words":[{"w":"Produced","start":188438,"end":189051},{"w":"a","start":189051,"end":189187},{"w":"0.5","start":189187,"end":189459},{"w":"megaton","start":189459,"end":190004},{"w":"amount","start":190004,"end":190480},{"w":"of","start":190480,"end":190684},{"w":"energy","start":190684,"end":191161},{"w":"when","start":191161,"end":191501},{"w":"it","start":191501,"end":191706},{"w":"blew","start":191706,"end":192046},{"w":"up","start":192046,"end":192250},{"w":"in","start":192250,"end":192454},{"w":"the","start":192454,"end":192727},{"w":"sky,","start":192727,"end":193067},{"w":"and","start":193067,"end":193639},{"w":"it","start":193639,"end":194068},{"w":"damaged","start":194068,"end":195212},{"w":"7,000","start":195212,"end":196070},{"w":"plus","start":196112,"end":196517},{"w":"buildings","start":196517,"end":197326},{"w":"and","start":197326,"end":197650},{"w":"over","start":197650,"end":198055},{"w":"1,000","start":198055,"end":198541},{"w":"reports","start":198541,"end":199189},{"w":"of","start":199189,"end":199431},{"w":"injuries.","start":199431,"end":200241}],"start":188438,"end":200241,"timing":"line","chunks":[0,1,7,11,14,17,20,24],"chunksByAi":true,"ja":"それは空で爆発したときに0.5メガトンのエネルギーを生成し、7000以上の建物を破壊し、1000件以上の負傷報告がありました。","edge":false,"segFrom":45,"segTo":47},{"id":"s15_203494","text":"So you go from a 20 meter object to a 60 meter object.","words":[{"w":"So","start":203494,"end":203820},{"w":"you","start":203820,"end":204254},{"w":"go","start":204254,"end":204579},{"w":"from","start":204579,"end":204996},{"w":"a","start":204996,"end":205163},{"w":"20","start":205163,"end":205413},{"w":"meter","start":205413,"end":205914},{"w":"object","start":205914,"end":206498},{"w":"to","start":206498,"end":206748},{"w":"a","start":206748,"end":206915},{"w":"60","start":206915,"end":207165},{"w":"meter","start":207165,"end":207666},{"w":"object.","start":207666,"end":208333}],"start":203494,"end":208333,"timing":"line","chunks":[0,3,8],"chunksByAi":true,"ja":"20メートルの物体から60メートルの物体に移ります。","edge":false,"segFrom":48,"segTo":49},{"id":"s16_208333","text":"The bigger the object, the bigger the punch.","words":[{"w":"The","start":208333,"end":208622},{"w":"bigger","start":208622,"end":209128},{"w":"the","start":209128,"end":209417},{"w":"object,","start":209417,"end":209996},{"w":"the","start":209996,"end":210285},{"w":"bigger","start":210285,"end":210791},{"w":"the","start":210791,"end":211080},{"w":"punch.","start":211080,"end":211586}],"start":208333,"end":211586,"timing":"line","chunks":[0,2,4,6],"chunksByAi":true,"ja":"物体が大きいほど、その威力も大きい。","edge":false,"segFrom":50,"segTo":50},{"id":"s17_214589","text":"So we knew we only had a few months where 2024 YR4 was going to be observable, and then it wouldn't be observable until June of 2028.","words":[{"w":"So","start":214589,"end":214839},{"w":"we","start":214839,"end":215089},{"w":"knew","start":215089,"end":215506},{"w":"we","start":215506,"end":215742},{"w":"only","start":215742,"end":216134},{"w":"had","start":216134,"end":216448},{"w":"a","start":216448,"end":216605},{"w":"few","start":216605,"end":216919},{"w":"months","start":216919,"end":217469},{"w":"where","start":217469,"end":217940},{"w":"2024","start":217940,"end":218333},{"w":"YR4","start":218333,"end":218647},{"w":"was","start":218647,"end":218961},{"w":"going","start":218961,"end":219432},{"w":"to","start":219432,"end":219667},{"w":"be","start":219667,"end":219903},{"w":"observable,","start":219903,"end":220845},{"w":"and","start":220845,"end":221094},{"w":"then","start":221094,"end":221405},{"w":"it","start":221405,"end":221591},{"w":"wouldn't","start":221591,"end":222151},{"w":"be","start":222151,"end":222337},{"w":"observable","start":222337,"end":223021},{"w":"until","start":223021,"end":223394},{"w":"June","start":223394,"end":223705},{"w":"of","start":223705,"end":223892},{"w":"2028.","start":223892,"end":224265}],"start":214589,"end":224265,"timing":"line","chunks":[0,3,6,9,12,17,23,25],"chunksByAi":true,"ja":"2024 YR4が観測可能なのは数ヶ月だけだと知っていました、そしてその後は2028年6月まで観測できませんでした。","edge":false,"segFrom":51,"segTo":53},{"id":"s18_225808","text":"That's why it was so critical to try to retire the risk before the object grew too faint to see it.","words":[{"w":"That's","start":225808,"end":226212},{"w":"why","start":226212,"end":226442},{"w":"it","start":226442,"end":226616},{"w":"was","start":226616,"end":226846},{"w":"so","start":226846,"end":227019},{"w":"critical","start":227019,"end":227538},{"w":"to","start":227538,"end":227711},{"w":"try","start":227711,"end":227942},{"w":"to","start":227942,"end":228115},{"w":"retire","start":228115,"end":228519},{"w":"the","start":228519,"end":228780},{"w":"risk","start":228780,"end":229107},{"w":"before","start":229107,"end":229564},{"w":"the","start":229564,"end":229825},{"w":"object","start":229825,"end":230283},{"w":"grew","start":230283,"end":230609},{"w":"too","start":230609,"end":230871},{"w":"faint","start":230871,"end":231262},{"w":"to","start":231262,"end":231458},{"w":"see","start":231458,"end":231720},{"w":"it.","start":231720,"end":231981}],"start":225808,"end":231981,"timing":"line","chunks":[0,2,6,12,18],"chunksByAi":true,"ja":"だから、物体が見えなくなる前にリスクを退けることがとても重要だったのです。","edge":false,"segFrom":54,"segTo":55},{"id":"s19_232523","text":"When the probability at the beginning was was still pretty small, one thing I noticed is that the Earth was dead on center within the uncertainty distribution.","words":[{"w":"When","start":232523,"end":232801},{"w":"the","start":232801,"end":233024},{"w":"probability","start":233024,"end":233691},{"w":"at","start":233691,"end":233858},{"w":"the","start":233858,"end":234080},{"w":"beginning","start":234080,"end":234637},{"w":"was","start":234637,"end":234859},{"w":"was","start":234859,"end":235082},{"w":"still","start":235082,"end":235415},{"w":"pretty","start":235415,"end":235805},{"w":"small,","start":235805,"end":236194},{"w":"one","start":236194,"end":236475},{"w":"thing","start":236475,"end":236896},{"w":"I","start":236896,"end":237037},{"w":"noticed","start":237037,"end":237599},{"w":"is","start":237599,"end":237810},{"w":"that","start":237810,"end":238161},{"w":"the","start":238161,"end":238442},{"w":"Earth","start":238442,"end":238863},{"w":"was","start":238863,"end":239144},{"w":"dead","start":239144,"end":239496},{"w":"on","start":239496,"end":239706},{"w":"center","start":239706,"end":240198},{"w":"within","start":240198,"end":240545},{"w":"the","start":240545,"end":240744},{"w":"uncertainty","start":240744,"end":241339},{"w":"distribution.","start":241339,"end":242033}],"start":232523,"end":242033,"timing":"line","chunks":[0,5,10,11,16,21,26],"chunksByAi":false,"ja":"最初の確率がまだ小さかったとき、地球が不確実性の分布の中心にぴったりあったことに気づきました。","edge":false,"segFrom":56,"segTo":58}],"segments":[{"text":"object candidate,\nand then submitted the observations","start":117909,"dur":3003},{"text":"to the Minor Planet\nCenter and went to bed.","start":120912,"dur":2211},{"text":"At first,\nwe didn't know it was very significant.","start":126126,"dur":2293},{"text":"It was one of several discoveries.","start":128419,"dur":2503},{"text":"The ATLAS survey,\noperated by the University of Hawaii,","start":134134,"dur":2711},{"text":"finds\nabout 200 to 250 near-Earth objects per year.","start":136845,"dur":4546},{"text":"This object was sort of a garden\nvariety new NEO.","start":141432,"dur":3045},{"text":"There was nothing about it","start":144561,"dur":875},{"text":"when we first saw it that suggested\nthat it would be especially dangerous.","start":145436,"dur":3254},{"text":"The impact probability climbed.","start":148731,"dur":3003},{"text":"It started to increase with more data.","start":151734,"dur":2545},{"text":"That's when things really\nkind of heated up for us.","start":154279,"dur":2002},{"text":"On December 22nd, 2032,","start":156281,"dur":3378},{"text":"there was a chance that it could impact\nEarth.","start":159784,"dur":3003},{"text":"From the measurements\ntaken from the ground,","start":164330,"dur":2711},{"text":"2024 YR4 was estimated\nto be about 40 to 90 meters in size.","start":167041,"dur":6006},{"text":"You're talking about an object\nthat could be a city killer.","start":173047,"dur":2837},{"text":"It was a large enough size\nto be dangerous,","start":175884,"dur":2085},{"text":"possibly the size of a jumbo jet.","start":177969,"dur":1627},{"text":"Well, if you remember the Chelyabinsk\nimpact of 2013 over Russia,","start":179596,"dur":4212},{"text":"that was estimated\nto be about a 20 meter asteroid.","start":183850,"dur":3920},{"text":"Produced a 0.5 megaton amount of energy\nwhen it blew up in the sky,","start":188438,"dur":4629},{"text":"and it damaged 7,000","start":193067,"dur":3003},{"text":"plus buildings\nand over 1,000 reports of injuries.","start":196112,"dur":4129},{"text":"So you go","start":203494,"dur":1085},{"text":"from a 20 meter object\nto a 60 meter object.","start":204579,"dur":3754},{"text":"The bigger\nthe object, the bigger the punch.","start":208333,"dur":3253},{"text":"So we knew","start":214589,"dur":917},{"text":"we only had a few months where 2024 YR4 was going to be observable,","start":215506,"dur":5339},{"text":"and then it wouldn't be observable\nuntil June of 2028.","start":220845,"dur":3420},{"text":"That's why it was so critical\nto try to retire","start":225808,"dur":2711},{"text":"the risk\nbefore the object grew too faint to see it.","start":228519,"dur":3462},{"text":"When the probability at the beginning\nwas was still pretty small,","start":232523,"dur":3671},{"text":"one thing I noticed\nis that the Earth was dead on center","start":236194,"dur":4004},{"text":"within the uncertainty distribution.","start":240198,"dur":1835}],"analysisVersion":1,"punctuatedByAi":false,"createdAt":0,"updatedAt":0,"sample":{"level":"B2","topic":"小惑星の発見と追跡（ドキュメンタリー）","reason":"研究者のインタビューで言い直しや口語が混ざる。専門的な内容（約 169 語/分）","wpm":169,"license":"パブリックドメイン（NASA・米国政府の著作物）","credit":"NASA","sourceUrl":"https://www.youtube.com/watch?v=5b3n-u_0QAI"}}