have","start":122032,"end":122440},{"w":"been","start":122440,"end":122848},{"w":"first","start":122848,"end":123337},{"w":"roasted","start":123337,"end":123990},{"w":"and","start":123990,"end":124517},{"w":"brewed","start":124517,"end":125439},{"w":"in","start":125439,"end":125834},{"w":"Yemen,","start":125834,"end":126757},{"w":"starting","start":126757,"end":127942},{"w":"in","start":127942,"end":128337},{"w":"the","start":128337,"end":128864},{"w":"1400s.","start":128864,"end":129787}],"start":115915,"end":129787,"timing":"estimated","chunks":[0,6,8,19,21],"chunksByAi":true,"ja":"野生のコーヒーの木はエチオピアから始まった可能性が高いが、1400年代にイエメンで最初に焙煎されて淹れられたと考えられている","edge":false,"segFrom":15,"segTo":16},{"id":"s11_129787","text":"In the 1600s, Indian monk Barbar Boudin is said to have taken seven raw coffee beans back to his homeland from Yemen, laying the beginnings for Coffee's worldwide takeover.","words":[{"w":"In","start":129787,"end":130182},{"w":"the","start":130182,"end":130709},{"w":"1600s,","start":130709,"end":131631},{"w":"Indian","start":131631,"end":132234},{"w":"monk","start":132234,"end":132665},{"w":"Barbar","start":132665,"end":133269},{"w":"Boudin","start":133269,"end":133872},{"w":"is","start":133872,"end":134130},{"w":"said","start":134130,"end":134561},{"w":"to","start":134561,"end":134820},{"w":"have","start":134820,"end":135251},{"w":"taken","start":135251,"end":135768},{"w":"seven","start":135768,"end":136308},{"w":"raw","start":136308,"end":136668},{"w":"coffee","start":136668,"end":137298},{"w":"beans","start":137298,"end":137838},{"w":"back","start":137838,"end":138288},{"w":"to","start":138288,"end":138557},{"w":"his","start":138557,"end":138917},{"w":"homeland","start":138917,"end":139727},{"w":"from","start":139727,"end":140177},{"w":"Yemen,","start":140177,"end":140807},{"w":"laying","start":140874,"end":141568},{"w":"the","start":141568,"end":141965},{"w":"beginnings","start":141965,"end":143057},{"w":"for","start":143057,"end":143453},{"w":"Coffee's","