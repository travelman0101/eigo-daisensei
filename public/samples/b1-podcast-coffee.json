d":71471},{"w":"for","start":71471,"end":71860},{"w":"the","start":71860,"end":72250},{"w":"world's","start":72250,"end":73029},{"w":"most","start":73029,"end":73515},{"w":"popular","start":73515,"end":74294},{"w":"kind","start":74294,"end":74781},{"w":"of","start":74781,"end":75073},{"w":"coffee.","start":75073,"end":75852}],"start":68739,"end":75852,"timing":"estimated","chunks":[0,2,5],"chunksByAi":true,"ja":"研究者たちは、世界で最も人気のあるコーヒーの種類の系図を作りました。","edge":false,"segFrom":8,"segTo":9},{"id":"s2_75852","text":"Scientists call it coffee.","words":[{"w":"Scientists","start":75852,"end":76923},{"w":"call","start":76923,"end":77410},{"w":"it","start":77410,"end":77702},{"w":"coffee.","start":77702,"end":78480}],"start":75852,"end":78480,"timing":"estimated","chunks":[0,3],"chunksByAi":true,"ja":"科学者たちはそれをコーヒーと呼びます。","edge":false,"segFrom":9,"segTo":9},{"id":"s3_78480","text":"Arabica car.","words":[{"w":"Arabica","start":78480,"end":79259},{"w":"car.","start":79259,"end":79746}],"start":78480,"end":79746,"timing":"estimated","chunks":[0],"chunksByAi":true,"ja":"アラビカカー。","edge":false,"segFrom":9,"segTo":9},{"id":"s4_79746","text":"Coffee lovers know it simply as Arabica.","words":[{"w":"Coffee","start":79746,"end":80393},{"w":"lovers","start":80393,"end":81041},{"w":"know","start":81041,"end":81503},{"w":"it","start":81503,"end":81781},{"w":"simply","start":81781,"end":82428},{"w":"as","start":82428,"end":82706},{"w":"Arabica.","start":82706,"end":83538}],"start":79746,"end":83538,"timing":"estimated","chunks":[0,4],"chunksByAi":true,"ja":"コーヒー好きはそれを単にアラビカと呼びます。","edge":false,"segFrom":10,"segTo":10},{"id":"s5_83538","text":"The researchers recently published a new study about coffee.","words":[{"w":"The","start":83538,"end":83908},{"w":"researchers","start":83908,"end":85018},{"w":"recently","start":85018,"end":85764},{"w":"published","start":85764,"end":86592},{"w":"a","start":86592,"end":86758},{"w":"new","start":86758,"end":87089},{"w":"study","start":87089,"end":87586},{"w":"about","start":87586,"end":88084},{"w":"coffee.","start":88084,"end":88746}],"start":83538,"end":88746,"timing":"estimated","chunks":[0,4,7],"chunksByAi":true,"ja":"研究者たちは最近、コーヒーについての新しい研究を発表しました。","edge":false,"segFrom":10,"segTo":11},{"id":"s6_88746","text":"They found that the species appeared around 600,000 years ago.","words":[{"w":"They","start":88746,"end":89161},{"w":"found","start":89161,"end":89658},{"w":"that","start":89658,"end":90072},{"w":"the","start":90072,"end":90404},{"w":"species","start":90404,"end":91066},{"w":"appeared","start":91066,"end":91812},{"w":"around","start":91812,"end":92392},{"w":"600,000","start":92392,"end":93236},{"w":"years","start":93236,"end":93868},{"w":"ago.","start":93868,"end":94395}],"start":88746,"end":94395,"timing":"estimated","chunks":[0,2,6],"chunksByAi":true,"ja":"彼らはその種が60万年前に現れたことを発見した","edge":false,"segFrom":11,"segTo":12},{"id":"s7_94395","text":"The plant was likely the result of natural breeding of two other coffee species.","words":[{"w":"The","start":94395,"end":94817},{"w":"plant","start":94817,"end":95450},{"w":"was","start":95450,"end":95872},{"w":"likely","start":95872,"end":96610},{"w":"the","start":96610,"end":97031},{"w":"result","start":97031,"end":97769},{"w":"of","start":97769,"end":98086},{"w":"natural","start":98086,"end":98929},{"w":"breeding","start":98929,"end":99878},{"w":"of","start":99878,"end":100195},{"w":"two","start":100195,"end":100616},{"w":"other","start":100616,"end":101249},{"w":"coffee","start":101249,"end":101987},{"w":"species.","start":101987,"end":102936}],"start":94395,"end":102936,"timing":"estimated","chunks":[0,4,9],"chunksByAi":true,"ja":"その植物は他の2種類のコーヒーの種の自然交配の結果だった可能性が高い","edge":false,"segFrom":12,"segTo":12},{"id":"s8_103036","text":"Victor Albert of the University at Buffalo was a co-leader of the study.","words":[{"w":"Victor","start":103036,"end":103730},{"w":"Albert","start":103730,"end":104424},{"w":"of","start":104424,"end":104722},{"w":"the","start":10472