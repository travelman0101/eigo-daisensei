{"id":"sample_c1-nasa-moonbound1","videoId":"bfw4G59j9uw","title":"Moonbound Episode 1 | Charting the Course","author":"NASA","videoDuration":1336000,"lang":"en","transcriptHash":"ad0dcffa42373830d3b42458ae67f910","source":"supadata","start":115048,"end":240000,"sentences":[{"id":"s0_115048","text":"And as we look towards Mars, the Moon is going to be an important staging area for us to learn quite a bit.","words":[{"w":"And","start":115048,"end":115253},{"w":"as","start":115253,"end":115407},{"w":"we","start":115407,"end":115561},{"w":"look","start":115561,"end":115817},{"w":"towards","start":115817,"end":116227},{"w":"Mars,","start":116227,"end":116535},{"w":"the","start":116535,"end":116740},{"w":"Moon","start":116740,"end":116996},{"w":"is","start":116996,"end":117150},{"w":"going","start":117217,"end":117541},{"w":"to","start":117541,"end":117703},{"w":"be","start":117703,"end":117865},{"w":"an","start":117865,"end":118027},{"w":"important","start":118027,"end":118568},{"w":"staging","start":118568,"end":119000},{"w":"area","start":119000,"end":119270},{"w":"for","start":119270,"end":119486},{"w":"us","start":119552,"end":119708},{"w":"to","start":119708,"end":119864},{"w":"learn","start":119864,"end":120177},{"w":"quite","start":120177,"end":120489},{"w":"a","start":120489,"end":120594},{"w":"bit.","start":120594,"end":120854}],"start":115048,"end":120854,"timing":"line","chunks":[0,1,6,12,16,20],"chunksByAi":true,"ja":"そして火星を見据える中、月は私たちが多くのことを学ぶための重要な拠点となるでしょう。","edge":false,"segFrom":45,"segTo":47},{"id":"s1_121387","text":"The longest we were ever on the moon as humans was 72 hours.","words":[{"w":"The","start":121387,"end":121564},{"w":"longest","start":121564,"end":121918},{"w":"we","start":121918,"end":122050},{"w":"were","start":122050,"end":122272},{"w":"ever","start":122272,"end":122493},{"w":"on","start":122493,"end":122625},{"w":"the","start":122625,"end":122802},{"w":"moon","start":122802,"end":123023},{"w":"as","start":123023,"end":123156},{"w":"humans","start":123223,"end":123746},{"w":"was","start":123746,"end":124044},{"w":"72","start":124044,"end":124268},{"w":"hours.","start":124268,"end":124791}],"start":121387,"end":124791,"timing":"line","chunks":[0,2,8,10],"chunksByAi":true,"ja":"私たち人間が月にいた最長の時間は72時間でした。","edge":false,"segFrom":48,"segTo":49},{"id":"s2_125592","text":"We have a lot to learn yet.","words":[{"w":"We","start":125592,"end":125767},{"w":"have","start":125767,"end":126059},{"w":"a","start":126059,"end":126176},{"w":"lot","start":126176,"end":126410},{"w":"to","start":126410,"end":126585},{"w":"learn","start":126585,"end":126935},{"w":"yet.","start":126935,"end":127227}],"start":125592,"end":127227,"timing":"line","chunks":[0,2,6],"chunksByAi":true,"ja":"私たちはまだ学ぶべきことがたくさんあります。","edge":false,"segFrom":50,"segTo":50},{"id":"s3_127961","text":"And as we leave the moon and towards Litrault, we leave as we came, and God willing, as we shall return with peace and hope from in time.","words":[{"w":"And","start":127961,"end":128241},{"w":"as","start":128241,"end":128451},{"w":"we","start":128451,"end":128662},{"w":"leave","start":128662,"end":129082},{"w":"the","start":129082,"end":129362},{"w":"moon","start":129429,"end":129670},{"w":"and","start":129670,"end":129863},{"w":"towards","start":129863,"end":130248},{"w":"Litrault,","start":130248,"end":130730},{"w":"we","start":131764,"end":131967},{"w":"leave","start":131967,"end":132373},{"w":"as","start":132373,"end":132576},{"w":"we","start":132576,"end":132778},{"w":"came,","start":132778,"end":133184},{"w":"and","start":133184,"end":133455},{"w":"God","start":133455,"end":133725},{"w":"willing,","start":133725,"end":134334},{"w":"as","start":134400,"end":134742},{"w":"we","start":134742,"end":135084},{"w":"shall","start":135084,"end":135768},{"w":"return","start":135768,"end":136566},{"w":"with","start":136566,"end":137136},{"w":"peace","start":137203,"end":138101},{"w":"and","start":138101,"end":138699},{"w":"hope","start":138699,"end":139447},{"w":"from","start":139447,"end":140195},{"w":"in","start":140195,"end":140643},{"w":"time.","start":140643,"end":141541}],"start":127961,"end":141541,"timing":"line","chunks":[0,1,6,9,11,14,17,21,25],"chunksByAi":true,"ja":"そして月を離れ、リトルートへ向かうとき、私たちは来たときと同じように去り、神のおぼしめしにより、平和と希望を持って再び戻ってくるでしょう。","edge":false,"segFrom":51,"segTo":55},{"id":"s4_145979","text":"The Artemis campaign is really a set of test flights.","words":[{"w":"The","start":145979,"end":146263},{"w":"Artemis","start":146263,"end":146830},{"w":"campaign","start":146830,"end":147467},{"w":"is","start":147467,"end":147680},{"w":"really","start":147747,"end":148417},{"w":"a","start":148417,"end":148608},{"w":"set","start":148608,"end":148991},{"w":"of","start":148991,"end":149278},{"w":"test","start":149278,"end":149756},{"w":"flights.","start":149756,"end":150617}],"start":145979,"end":150617,"timing":"line","chunks":[0,3,5],"chunksByAi":true,"ja":"アルテミス計画は、実際には一連のテスト飛行です。","edge":false,"segFrom":56,"segTo":57},{"id":"s5_150917","text":"We haven't been to the moon in over 50 years.","words":[{"w":"We","start":150917,"end":151035},{"w":"haven't","start":151035,"end":151348},{"w":"been","start":151348,"end":151544},{"w":"to","start":151544,"end":151661},{"w":"the","start":151661,"end":151818},{"w":"moon","start":151885,"end":152255},{"w":"in","start":152255,"end":152477},{"w":"over","start":152477,"end":152846},{"w":"50","start":152846,"end":153068},{"w":"years.","start":153068,"end":153586}],"start":150917,"end":153586,"timing":"line","chunks":[0,3,6],"chunksByAi":true,"ja":"私たちは50年以上月へ行っていません。","edge":false,"segFrom":58,"segTo":59},{"id":"s6_153653","text":"And so there's a lot of new systems that we need to test out.","words":[{"w":"And","start":153653,"end":153842},{"w":"so","start":153842,"end":153984},{"w":"there's","start":153984,"end":154362},{"w":"a","start":154362,"end":154457},{"w":"lot","start":154457,"end":154646},{"w":"of","start":154646,"end":154788},{"w":"new","start":154788,"end":154977},{"w":"systems","start":154977,"end":155355},{"w":"that","start":155421,"end":155659},{"w":"we","start":155659,"end":155801},{"w":"need","start":155801,"end":156039},{"w":"to","start":156039,"end":156181},{"w":"test","start":156181,"end":156419},{"w":"out.","start":156419,"end":156656}],"start":153653,"end":156656,"timing":"line","chunks":[0,2,8],"chunksByAi":true,"ja":"だから、テストする必要がある新しいシステムがたくさんあります","edge":false,"segFrom":60,"segTo":61},{"id":"s7_156723","text":"We're going to a new part of the moon, the South Pole that we've never been to before with crew.","words":[{"w":"We're","start":156723,"end":156923},{"w":"going","start":156923,"end":157123},{"w":"to","start":157123,"end":157223},{"w":"a","start":157223,"end":157290},{"w":"new","start":157290,"end":157423},{"w":"part","start":157423,"end":157590},{"w":"of","start":157657,"end":157768},{"w":"the","start":157768,"end":157916},{"w":"moon,","start":157916,"end":158137},{"w":"the","start":158137,"end":158285},{"w":"South","start":158285,"end":158506},{"w":"Pole","start":158506,"end":158691},{"w":"that","start":158758,"end":158925},{"w":"we've","start":158925,"end":159125},{"w":"never","start":159125,"end":159325},{"w":"been","start":159325,"end":159492},{"w":"to","start":159559,"end":159721},{"w":"before","start":159721,"end":160099},{"w":"with","start":160099,"end":160369},{"w":"crew.","start":160369,"end":160693}],"start":156723,"end":160693,"timing":"line","chunks":[0,9,12,18],"chunksByAi":true,"ja":"私たちは、乗組員を連れて行ったことのない月の新しい場所、南極に行きます","edge":false,"segFrom":62,"segTo":65},{"id":"s8_160760","text":"The Artemis 2 mission is going to take the next step in our flight test campaign.","words":[{"w":"The","start":160760,"end":161070},{"w":"Artemis","start":161070,"end":161689},{"w":"2","start":161689,"end":161844},{"w":"mission","start":161844,"end":162463},{"w":"is","start":162463,"end":162695},{"w":"going","start":162762,"end":163255},{"w":"to","start":163255,"end":163502},{"w":"take","start":163502,"end":163913},{"w":"the","start":163913,"end":164242},{"w":"next","start":164242,"end":164653},{"w":"step","start":164653,"end":165064},{"w":"in","start":165398,"end":165650},{"w":"our","start":165650,"end":165986},{"w":"flight","start":165986,"end":166574},{"w":"test","start":166574,"end":166994},{"w":"campaign.","start":166994,"end":167834}],"start":160760,"end":167834,"timing":"line","chunks":[0,4,11],"chunksByAi":true,"ja":"アーティミス2号のミッションは、私たちの飛行試験キャンペーンの次のステップを踏み出します","edge":false,"segFrom":66,"segTo":68},{"id":"s9_168401","text":"We're going to focus on what are the new systems that we need to test out","words":[{"w":"We're","start":168401,"end":168808},{"w":"going","start":168808,"end":169216},{"w":"to","start":169216,"end":169419},{"w":"focus","start":169419,"end":169827},{"w":"on","start":169827,"end":170031},{"w":"what","start":170031,"end":170370},{"w":"are","start":170436,"end":170693},{"w":"the","start":170693,"end":170951},{"w":"new","start":170951,"end":171208},{"w":"systems","start":171208,"end":171723},{"w":"that","start":171723,"end":172045},{"w":"we","start":172045,"end":172238},{"w":"need","start":172305,"end":172592},{"w":"to","start":172592,"end":172764},{"w":"test","start":172764,"end":173051},{"w":"out","start":173051,"end":173281}],"start":168401,"end":173281,"timing":"estimated","chunks":[0,5,10],"chunksByAi":true,"ja":"私たちは、テストする必要がある新しいシステムに焦点を当てます","edge":false,"segFrom":69,"segTo":71},{"id":"s10_173281","text":"so that we can fly crew to the moon and safely bring them back home.","words":[{"w":"so","start":173281,"end":173453},{"w":"that","start":173453,"end":173740},{"w":"we","start":173806,"end":174053},{"w":"can","start":174053,"end":174382},{"w":"fly","start":174382,"end":174711},{"w":"crew","start":174711,"end":175122},{"w":"to","start":175122,"end":175369},{"w":"the","start":175369,"end":175698},{"w":"moon","start":175698,"end":176109},{"w":"and","start":176175,"end":176373},{"w":"safely","start":176373,"end":176720},{"w":"bring","start":176720,"end":177017},{"w":"them","start":177017,"end":177265},{"w":"back","start":177265,"end":177513},{"w":"home.","start":177513,"end":177810}],"start":173281,"end":177810,"timing":"estimated","chunks":[0,9],"chunksByAi":true,"ja":"そのために、私たちは乗組員を月に飛ばし、安全に地球に帰すことができます","edge":false,"segFrom":71,"segTo":73},{"id":"s11_178144","text":"That really sets us up for our big goal, which is the return of human crew to the surface of the moon.","words":[{"w":"That","start":178144,"end":178527},{"w":"really","start":178527,"end":179062},{"w":"sets","start":179062,"end":179445},{"w":"us","start":179445,"end":179674},{"w":"up","start":179674,"end":179904},{"w":"for","start":179904,"end":180210},{"w":"our","start":180210,"end":180516},{"w":"big","start":180516,"end":180822},{"w":"goal,","start":180822,"end":181281},{"w":"which","start":181514,"end":182085},{"w":"is","start":182085,"end":182371},{"w":"the","start":182371,"end":182752},{"w":"return","start":182752,"end":183418},{"w":"of","start":183418,"end":183704},{"w":"human","start":183704,"end":184275},{"w":"crew","start":184275,"end":184751},{"w":"to","start":184817,"end":185007},{"w":"the","start":185007,"end":185259},{"w":"surface","start":185259,"end":185765},{"w":"of","start":185765,"end":185954},{"w":"the","start":185954,"end":186207},{"w":"moon.","start":186207,"end":186586}],"start":178144,"end":186586,"timing":"line","chunks":[0,5,9,16],"chunksByAi":true,"ja":"それは、私たちの大きな目標、つまり月面への人間の乗組員の帰還に向けて私たちを準備します","edge":false,"segFrom":74,"segTo":76},{"id":"s12_186920","text":"It's so important what we learn in that mission to the moon because it instructs us on how we're going to get to Mars.","words":[{"w":"It's","start":186920,"end":187144},{"w":"so","start":187144,"end":187279},{"w":"important","start":187279,"end":187728},{"w":"what","start":187728,"end":187952},{"w":"we","start":187952,"end":188087},{"w":"learn","start":188154,"end":188443},{"w":"in","start":188443,"end":188587},{"w":"that","start":188587,"end":188827},{"w":"mission","start":188827,"end":189212},{"w":"to","start":189212,"end":189356},{"w":"the","start":189356,"end":189549},{"w":"moon","start":189549,"end":189789},{"w":"because","start":190156,"end":190495},{"w":"it","start":190495,"end":190622},{"w":"instructs","start":190622,"end":191046},{"w":"us","start":191046,"end":191173},{"w":"on","start":191173,"end":191300},{"w":"how","start":191300,"end":191470},{"w":"we're","start":191470,"end":191724},{"w":"going","start":191791,"end":191937},{"w":"to","start":191937,"end":192009},{"w":"get","start":192009,"end":192107},{"w":"to","start":192107,"end":192179},{"w":"Mars.","start":192179,"end":192325}],"start":186920,"end":192325,"timing":"line","chunks":[0,3,6,12,16,22],"chunksByAi":true,"ja":"その月へのミッションで学ぶことはとても大切です。なぜなら、それが私たちに火星へ行く方法を教えてくれるからです。","edge":false,"segFrom":77,"segTo":80},{"id":"s13_193159","text":"This is a generation defining effort.","words":[{"w":"This","start":193159,"end":193422},{"w":"is","start":193422,"end":193580},{"w":"a","start":193580,"end":193686},{"w":"generation","start":193686,"end":194265},{"w":"defining","start":194265,"end":194740},{"w":"effort.","start":194740,"end":195161}],"start":193159,"end":195161,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"これは世代を決定づける努力です。","edge":false,"segFrom":81,"segTo":81},{"id":"s14_200600","text":"My name's Jeff Radigan.","words":[{"w":"My","start":200600,"end":200692},{"w":"name's","start":200692,"end":200906},{"w":"Jeff","start":200906,"end":201059},{"w":"Radigan.","start":201059,"end":201334}],"start":200600,"end":201334,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"私の名前はジェフ・ラディガンです。","edge":false,"segFrom":82,"segTo":82},{"id":"s15_201701","text":"I'm the lead flight director for Artemis 2.","words":[{"w":"I'm","start":201701,"end":201788},{"w":"the","start":201788,"end":201875},{"w":"lead","start":201875,"end":201983},{"w":"flight","start":201983,"end":202135},{"w":"director","start":202201,"end":202552},{"w":"for","start":202552,"end":202707},{"w":"Artemis","start":202707,"end":203019},{"w":"2.","start":203019,"end":203136}],"start":201701,"end":203136,"timing":"line","chunks":[0,1,5],"chunksByAi":true,"ja":"私はアーティミス2の飛行ディレクターを務めています。","edge":false,"segFrom":83,"segTo":84},{"id":"s16_204537","text":"Here in mission control, I direct the operations of the spacecraft and communicate with the crew on board in","words":[{"w":"Here","start":204537,"end":204721},{"w":"in","start":204721,"end":204832},{"w":"mission","start":204832,"end":205127},{"w":"control,","start":205127,"end":205459},{"w":"I","start":205459,"end":205533},{"w":"direct","start":205533,"end":205791},{"w":"the","start":205791,"end":205939},{"w":"operations","start":206005,"end":206661},{"w":"of","start":206661,"end":206840},{"w":"the","start":206840,"end":207079},{"w":"spacecraft","start":207079,"end":207735},{"w":"and","start":207735,"end":207974},{"w":"communicate","start":208041,"end":208460},{"w":"with","start":208460,"end":208635},{"w":"the","start":208635,"end":208775},{"w":"crew","start":208841,"end":209028},{"w":"on","start":209028,"end":209140},{"w":"board","start":209140,"end":209365},{"w":"in","start":209365,"end":209477}],"start":204537,"end":209477,"timing":"estimated","chunks":[0,4,8,11,16],"chunksByAi":true,"ja":"ここミッション・コントロールでは、宇宙船の運用を指揮し、乗組員と連絡を取ります。","edge":false,"segFrom":85,"segTo":88},{"id":"s17_209477","text":"order to have a successful mission of the first mission back to lunar space in over 50 years.","words":[{"w":"order","start":209477,"end":209702},{"w":"to","start":209702,"end":209814},{"w":"have","start":209814,"end":210001},{"w":"a","start":210001,"end":210076},{"w":"successful","start":210143,"end":210679},{"w":"mission","start":210679,"end":211070},{"w":"of","start":211070,"end":211216},{"w":"the","start":211216,"end":211411},{"w":"first","start":211477,"end":211684},{"w":"mission","start":211684,"end":211961},{"w":"back","start":211961,"end":212134},{"w":"to","start":212134,"end":212238},{"w":"lunar","start":212238,"end":212445},{"w":"space","start":212512,"end":212812},{"w":"in","start":212812,"end":212962},{"w":"over","start":212962,"end":213213},{"w":"50","start":213213,"end":213363},{"w":"years.","start":213363,"end":213713}],"start":209477,"end":213713,"timing":"estimated","chunks":[0,3,6,10,14],"chunksByAi":true,"ja":"50年以上ぶりに月周回軌道への最初のミッションを成功させるためです。","edge":false,"segFrom":88,"segTo":91},{"id":"s18_214347","text":"We want to get back out to lunar space.","words":[{"w":"We","start":214347,"end":214467},{"w":"want","start":214467,"end":214667},{"w":"to","start":214667,"end":214788},{"w":"get","start":214788,"end":214948},{"w":"back","start":214948,"end":215148},{"w":"out","start":215148,"end":215308},{"w":"to","start":215308,"end":215428},{"w":"lunar","start":215428,"end":215669},{"w":"space.","start":215669,"end":215949}],"start":214347,"end":215949,"timing":"line","chunks":[0,4,7],"chunksByAi":true,"ja":"私たちは再び月へ行きたいと思っています。","edge":false,"segFrom":92,"segTo":92},{"id":"s19_216015","text":"We want to fly around the moon.","words":[{"w":"We","start":216015,"end":216128},{"w":"want","start":216128,"end":216315},{"w":"to","start":216315,"end":216428},{"w":"fly","start":216428,"end":216578},{"w":"around","start":216578,"end":216841},{"w":"the","start":216841,"end":216991},{"w":"moon.","start":216991,"end":217216}],"start":216015,"end":217216,"timing":"line","chunks":[0,4],"chunksByAi":true,"ja":"私たちは月の周りを飛びたいと思っています。","edge":false,"segFrom":93,"segTo":93},{"id":"s20_217717","text":"And so to be a part of that is just very meaningful to me.","words":[{"w":"And","start":217717,"end":217850},{"w":"so","start":217850,"end":217951},{"w":"to","start":217951,"end":218051},{"w":"be","start":218051,"end":218151},{"w":"a","start":218151,"end":218217},{"w":"part","start":218217,"end":218384},{"w":"of","start":218384,"end":218484},{"w":"that","start":218484,"end":218651},{"w":"is","start":218718,"end":218896},{"w":"just","start":218896,"end":219192},{"w":"very","start":219192,"end":219488},{"w":"meaningful","start":219488,"end":220139},{"w":"to","start":220139,"end":220316},{"w":"me.","start":220316,"end":220553}],"start":217717,"end":220553,"timing":"line","chunks":[0,4,8,12],"chunksByAi":true,"ja":"その一部になることは私にとって非常に意味のあることです。","edge":false,"segFrom":94,"segTo":95},{"id":"s21_221120","text":"It's something I get excited about when I wake up in the morning.","words":[{"w":"It's","start":221120,"end":221315},{"w":"something","start":221315,"end":221704},{"w":"I","start":221704,"end":221782},{"w":"get","start":221782,"end":221938},{"w":"excited","start":221938,"end":222249},{"w":"about","start":222249,"end":222483},{"w":"when","start":222483,"end":222677},{"w":"I","start":222677,"end":222755},{"w":"wake","start":222822,"end":222968},{"w":"up","start":222968,"end":223056},{"w":"in","start":223056,"end":223143},{"w":"the","start":223143,"end":223260},{"w":"morning.","start":223260,"end":223523}],"start":221120,"end":223523,"timing":"line","chunks":[0,2,6,10],"chunksByAi":true,"ja":"朝起きたときに興奮することです。","edge":false,"segFrom":96,"segTo":97},{"id":"s22_223856","text":"It really is the next step in space exploration.","words":[{"w":"It","start":223856,"end":223984},{"w":"really","start":223984,"end":224281},{"w":"is","start":224281,"end":224409},{"w":"the","start":224409,"end":224579},{"w":"next","start":224579,"end":224791},{"w":"step","start":224857,"end":225080},{"w":"in","start":225080,"end":225213},{"w":"space","start":225213,"end":225480},{"w":"exploration.","start":225480,"end":226059}],"start":223856,"end":226059,"timing":"line","chunks":[0,3,6],"chunksByAi":true,"ja":"これは宇宙探査の次のステップです。","edge":false,"segFrom":98,"segTo":99},{"id":"s23_231297","text":"This room has a lot of historical significance.","words":[{"w":"This","start":231297,"end":231449},{"w":"room","start":231449,"end":231602},{"w":"has","start":231602,"end":231724},{"w":"a","start":231724,"end":231785},{"w":"lot","start":231785,"end":231907},{"w":"of","start":231907,"end":231998},{"w":"historical","start":232065,"end":232637},{"w":"significance.","start":232637,"end":233366}],"start":231297,"end":233366,"timing":"line","chunks":[0,3],"chunksByAi":true,"ja":"この部屋は歴史的な意義があります。","edge":false,"segFrom":100,"segTo":101},{"id":"s24_234133","text":"We originally flew the space shuttle out of here and we're looking forward to flying Artemis 2 out of this room here in the not too distant future.","words":[{"w":"We","start":234133,"end":234245},{"w":"originally","start":234245,"end":234657},{"w":"flew","start":234657,"end":234844},{"w":"the","start":234844,"end":234994},{"w":"space","start":234994,"end":235219},{"w":"shuttle","start":235219,"end":235518},{"w":"out","start":235518,"end":235668},{"w":"of","start":235735,"end":235862},{"w":"here","start":235862,"end":236074},{"w":"and","start":236074,"end":236243},{"w":"we're","start":236243,"end":236497},{"w":"looking","start":236497,"end":236836},{"w":"forward","start":236903,"end":237170},{"w":"to","start":237170,"end":237270},{"w":"flying","start":237270,"end":237503},{"w":"Artemis","start":237503,"end":237770},{"w":"2","start":237837,"end":237919},{"w":"out","start":237919,"end":238082},{"w":"of","start":238082,"end":238204},{"w":"this","start":238204,"end":238408},{"w":"room","start":238408,"end":238612},{"w":"here","start":238612,"end":238816},{"w":"in","start":238816,"end":238938},{"w":"the","start":239005,"end":239119},{"w":"not","start":239119,"end":239234},{"w":"too","start":239234,"end":239348},{"w":"distant","start":239348,"end":239577},{"w":"future.","start":239577,"end":239806}],"start":234133,"end":239806,"timing":"line","chunks":[0,6,9,17,21],"chunksByAi":true,"ja":"私たちは元々この場所からスペースシャトルを飛ばしました。そして、近い将来にこの部屋からアルテミス2を飛ばすことを楽しみにしています。","edge":false,"segFrom":102,"segTo":106}],"segments":[{"text":"And as we look towards Mars, the Moon is","start":115048,"dur":2102},{"text":"going to be an important staging area for","start":117217,"dur":2269},{"text":"us to learn quite a bit.","start":119552,"dur":1302},{"text":"The longest we were ever on the moon as","start":121387,"dur":1769},{"text":"humans was 72 hours.","start":123223,"dur":1568},{"text":"We have a lot to learn yet.","start":125592,"dur":1635},{"text":"And as we leave the","start":127961,"dur":1401},{"text":"moon and towards Litrault,","start":129429,"dur":1301},{"text":"we leave as we came, and God willing,","start":131764,"dur":2570},{"text":"as we shall return with","start":134400,"dur":2736},{"text":"peace and hope from in time.","start":137203,"dur":4338},{"text":"The Artemis campaign is","start":145979,"dur":1701},{"text":"really a set of test flights.","start":147747,"dur":2870},{"text":"We haven't been to the","start":150917,"dur":901},{"text":"moon in over 50 years.","start":151885,"dur":1701},{"text":"And so there's a lot of new systems","start":153653,"dur":1702},{"text":"that we need to test out.","start":155421,"dur":1235},{"text":"We're going to a new part","start":156723,"dur":867},{"text":"of the moon, the South Pole","start":157657,"dur":1034},{"text":"that we've never been","start":158758,"dur":734},{"text":"to before with crew.","start":159559,"dur":1134},{"text":"The Artemis 2 mission is","start":160760,"dur":1935},{"text":"going to take the next step","start":162762,"dur":2302},{"text":"in our flight test campaign.","start":165398,"dur":2436},{"text":"We're going to focus on what","start":168401,"dur":1969},{"text":"are the new systems that we","start":170436,"dur":1802},{"text":"need to test out so that","start":172305,"dur":1435},{"text":"we can fly crew to the moon","start":173806,"dur":2303},{"text":"and safely bring them back home.","start":176175,"dur":1635},{"text":"That really sets us up for our big goal,","start":178144,"dur":3137},{"text":"which is the return of human crew","start":181514,"dur":3237},{"text":"to the surface of the moon.","start":184817,"dur":1769},{"text":"It's so important what we","start":186920,"dur":1167},{"text":"learn in that mission to the moon","start":188154,"dur":1635},{"text":"because it instructs us on how we're","start":190156,"dur":1568},{"text":"going to get to Mars.","start":191791,"dur":534},{"text":"This is a generation defining effort.","start":193159,"dur":2002},{"text":"My name's Jeff Radigan.","start":200600,"dur":734},{"text":"I'm the lead flight","start":201701,"dur":434},{"text":"director for Artemis 2.","start":202201,"dur":935},{"text":"Here in mission control, I direct the","start":204537,"dur":1402},{"text":"operations of the spacecraft and","start":206005,"dur":1969},{"text":"communicate with the","start":208041,"dur":734},{"text":"crew on board in order to have a","start":208841,"dur":1235},{"text":"successful mission of the","start":210143,"dur":1268},{"text":"first mission back to lunar","start":211477,"dur":968},{"text":"space in over 50 years.","start":212512,"dur":1201},{"text":"We want to get back out to lunar space.","start":214347,"dur":1602},{"text":"We want to fly around the moon.","start":216015,"dur":1201},{"text":"And so to be a part of that","start":217717,"dur":934},{"text":"is just very meaningful to me.","start":218718,"dur":1835},{"text":"It's something I get excited about when I","start":221120,"dur":1635},{"text":"wake up in the morning.","start":222822,"dur":701},{"text":"It really is the next","start":223856,"dur":935},{"text":"step in space exploration.","start":224857,"dur":1202},{"text":"This room has a lot of","start":231297,"dur":701},{"text":"historical significance.","start":232065,"dur":1301},{"text":"We originally flew the space shuttle out","start":234133,"dur":1535},{"text":"of here and we're looking","start":235735,"dur":1101},{"text":"forward to flying Artemis","start":236903,"dur":867},{"text":"2 out of this room here in","start":237837,"dur":1101},{"text":"the not too distant future.","start":239005,"dur":801}],"analysisVersion":1,"punctuatedByAi":false,"createdAt":0,"updatedAt":0,"sample":{"level":"C1","topic":"ドキュメンタリー「Moonbound」第 1 話","reason":"複数の話し手の自然な語りとインタビュー。速く、抽象的な表現が多い（約 216 語/分）","wpm":216,"license":"パブリックドメイン（NASA・米国政府の著作物）","credit":"NASA","sourceUrl":"https://www.youtube.com/watch?v=bfw4G59j9uw"}}