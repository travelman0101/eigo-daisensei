 go across the different regions that we expect to see water ice.","words":[{"w":"After","start":137737,"end":138031},{"w":"we","start":138031,"end":138178},{"w":"land,","start":138178,"end":138472},{"w":"we're","start":138472,"end":138766},{"w":"going","start":138766,"end":139060},{"w":"to","start":139060,"end":139207},{"w":"start","start":139207,"end":139502},{"w":"a","start":139502,"end":139600},{"w":"traverse","start":139600,"end":140041},{"w":"and","start":140041,"end":140237},{"w":"we","start":140237,"end":140384},{"w":"go","start":140384,"end":140531},{"w":"across","start":140531,"end":140874},{"w":"the","start":140874,"end":141129},{"w":"different","start":141129,"end":141766},{"w":"regions","start":141766,"end":142275},{"w":"that","start":142275,"end":142594},{"w":"we","start":142594,"end":142785},{"w":"expect","start":142785,"end":143231},{"w":"to","start":143231,"end":143422},{"w":"see","start":143422,"end":143676},{"w":"water","start":143676,"end":144059},{"w":"ice.","start":144059,"end":144377}],"start":137737,"end":144377,"timing":"line","chunks":[0,3,9,13,16],"chunksByAi":true,"ja":"着陸した後、私たちは横断を始め、水の氷があると予想される異なる地域を横断します。","edge":false,"segFrom":38,"segTo":39},{"id":"s13_144611","text":"We're always collecting data.","words":[{"w":"We're","start":144611,"end":144898},{"w":"always","start":144898,"end":145232},{"w":"collecting","start":145232,"end":145758},{"w":"data.","start":145758,"end":146045}],"start":144611,"end":146045,"timing":"line","chunks":[0],"chunksByAi":true,"ja":"私たちは常にデータを収集しています。","edge":false,"segFrom":40,"segTo":40},{"id":"s14_146045","text":"The rover’s instruments are always on, so we get a lot of statistics as we drive.","words":[{"w":"The","start":146045,"end":146226},{"w":"rover’s","start":146226,"end":146587},{"w":"instruments","start":146587,"end":147129},{"w":"are","start":147129,"end":147310},{"w":"always","start":147310,"end":147626},{"w":"on,","start":147626,"end":147807},{"w":"so","start":147807,"end":147942},{"w":"we","start":147942,"end":148078},{"w":"get","start":148078,"end":148258},{"w":"a","start":148258,"end":148349},{"w":"lot","start":148349,"end":148529},{"w":"of","start":148529,"end":148665},{"w":"statistics","start":148665,"end":149162},{"w":"as","start":149162,"end":149297},{"w":"we","start":149297,"end":149433},{"w":"drive.","start":149433,"end":149749}],"start":146045,"end":149749,"timing":"line","chunks":[0,3,6,13],"chunksByAi":true,"ja":"ローバーの機器は常に作動しているので、走行中に多くの統計データを得ます。","edge":false,"segFrom":41,"segTo":41},{"id":"s15_149816","text":"We'll stop in specific areas that we think there should be a signature of a certain amount","words":[{"w":"We'll","start":149816,"end":150247},{"w":"stop","start":150247,"end":150606},{"w":"in","start":150606,"end":150821},{"w":"specific","start":150821,"end":151468},{"w":"areas","start":151468,"end":151899},{"w":"that","start":151899,"end":152258},{"w":"we","start":152258,"end":152473},{"w":"think","start":152473,"end":152904},{"w":"there","start":152904,"end":153335},{"w":"should","start":153335,"end":153838},{"w":"be","start":153838,"end":154053},{"w":"a","start":154053,"end":154172},{"w":"signature","start":154172,"end":154769},{"w":"of","start":154769,"end":154948},{"w":"a","start":154948,"end":155067},{"w":"certain","start":155067,"end":155545},{"w":"amount","start":155545,"end":155962}],"start":149816,"end":155962,"timing":"estimated","chunks":[0,5,8,13],"chunksByAi":true,"ja":"私たちは、ある程度の特徴があると考えられる特定の地域で停止します。","edge":false,"segFrom":42,"segTo":43},{"id":"s16_155962","text":"and do a little more concentrated investigation there and go on to the next one.","words":[{"w":"and","start":155962,"end":156201},{"w":"do","start":156201,"end":156380},{"w":"a","start":156380,"end":156499},{"w":"little","start":156499,"end":156917},{"w":"more","start":156917,"end":157215},{"w":"concentrated","start":157215,"end":157991},{"w":"investigation","start":157991,"end":158886},{"w":"there","start":158886,"end":159269},{"w":"and","start":159269,"end":159524},{"w":"go","start":159524,"end":159716},{"w":"on","start":159716,"end":159908},{"w":"to","start":159908,"end":160099},{"w":"the","start":160099,"end":160355},{"w":"next","start":160355,"end":160675},{"w":"one.","start":160675,"end":160994}],"start":155962,"end":160994,"timing":"estimated","chunks":[0,7,8],"chunksByAi":true,"ja":"そしてそこで少し集中した調査を行い、次の場所に進みます。","edge":false,"segFrom":43,"segTo":44},{"id":"s17_161060","text":"And then eventually also do this in, permanently shadowed region.","words":[{"w":"And","start":161060,"end":161256},{"w":"then","start":161256,"end":161501},{"w":"eventually","start":161501,"end":162041},{"w":"also","start":162041,"end":162286},{"w":"do","start":162286,"end":162433},{"w":"this","start":162433,"end":162679},{"w":"in,","start":162679,"end":162875},{"w":"permanently","start":162875,"end":163463},{"w":"shadowed","start":163463,"end":163905},{"w":"region.","start":163905,"end":164297}],"start":161060,"end":164297,"timing":"line","chunks":[0,3,7],"chunksByAi":true,"ja":"そして最終的には、永久に日陰のある地域でもこれを行います。","edge":false,"segFrom":45,"segTo":45},{"id":"s18_164497","text":"These regions don't see sun for billions of years.","words":[{"w":"These","start":164497,"end":164854},{"w":"regions","start":164854,"end":165331},{"w":"don't","start":165331,"end":165688},{"w":"see","start":165688,"end":165926},{"w":"sun","start":165926,"end":166164},{"w":"for","start":166164,"end":166403},{"w":"billions","start":166403,"end":166939},{"w":"of","start":166939,"end":167117},{"w":"years.","start":167117,"end":167534}],"start":164497,"end":167534,"timing":"line","chunks":[0,2,5],"chunksByAi":true,"ja":"この地域は数十億年も太陽を見ていない。","edge":false,"segFrom":46,"segTo":46},{"id":"s19_167700","text":"So it’s been cold there for a really, really long time, almost absolute zero.","words":[{"w":"So","start":167700,"end":167857},{"w":"it’s","start":167857,"end":168118},{"w":"been","start":168118,"end":168379},{"w":"cold","start":168379,"end":168639},{"w":"there","start":168639,"end":168953},{"w":"for","start":168953,"end":169161},{"w":"a","start":169161,"end":169266},{"w":"really,","start":169266,"end":169683},{"w":"really","start":169683,"end":170049},{"w":"long","start":170049,"end":170310},{"w":"time,","start":170310,"end":170623},{"w":"almost","start":170623,"end":170988},{"w":"absolute","start":170988,"end":171458},{"w":"zero.","start":171458,"end":171771}],"start":167700,"end":171771,"timing":"line","chunks":[0,4,8,11],"chunksByAi":true,"ja":"だから、そこはほとんど絶対零度に近い、本当に、本当に長い間寒かったのです。","edge":false,"segFrom":47,"segTo":47},{"id":"s20_171905","text":"And that is a place where ice will collect and settle.","words":[{"w":"And","start":171905,"end":172172},{"w":"that","start":172172,"end":172506},{"w":"is","start":172506,"end":172706},{"w":"a","start":172706,"end":172839},{"w":"place","start":172839,"end":173240},{"w":"where","start":173240,"end":173640},{"w":"ice","start":173640,"end":173907},{"w":"will","start":173907,"end":174240},{"w":"collect","start":174240,"end":174774},{"w":"and","start":174774,"end":175041},{"w":"settle.","start":175041,"end":175575}],"start":171905,"end":175575,"timing":"line","chunks":[0,5,9],"chunksByAi":true,"ja":"そして、それは氷が集まり、定着する場所です。","edge":false,"segFrom":48,"segTo":48},{"id":"s21_177210","text":"We cover a large distance in the first 100 days.","words":[{"w":"We","start":177210,"end":177416},{"w":"cover","start":177416,"end":177829},{"w":"a","start":177829,"end":177967},{"w":"large","start":177967,"end":178379},{"w":"distance","start":178379,"end":178998},{"w":"in","start":178998,"end":179204},{"w":"the","start":179204,"end":179480},{"w":"first","start":179480,"end":179892},{"w":"100","start":179892,"end":180167},{"w":"days.","start":180167,"end":180580}],"start":177210,"end":180580,"timing":"line","chunks":[0,2,5],"chunksByAi":true,"ja":"最初の100日間で、私たちは広大な距離を覆います。","edge":false,"segFrom":49,"segTo":49}],"segments":[{"text":"The lunar South Pole region is vast,\nspreading hundreds of square miles","start":53520,"dur":3937},{"text":"and NASA is carefully studying\nseveral promising sites","start":57457,"dur":3370},{"text":"for future lunar landings and operations.","start":60827,"dur":3003},{"text":"During the first phase of Moon Base\ndevelopment, robotic rovers will traverse","start":63997,"dur":3804},{"text":"the rugged lunar landscape, gathering\nnew insights into the environment.","start":67801,"dur":3703},{"text":"Lunar terrain vehicles will help carry\nArtemis astronauts across the region,","start":71604,"dur":3871},{"text":"extending the reach of each mission\nand opening new possibilities","start":75708,"dur":3738},{"text":"for scientific discovery.","start":79446,"dur":1835},{"text":"Together, these capabilities will deepen\nour understanding of this remarkable part","start":81281,"dur":4237},{"text":"of the Moon and help shape\nwhere we build, how","start":85518,"dur":3170},{"text":"we build, and what we explore next.","start":88688,"dur":3003},{"text":"One of NASA's first rovers to study\nthe lunar surface will be VIPER,","start":91858,"dur":3971},{"text":"a robotic rover designed to search for ice\nand other resources.","start":96062,"dur":4104},{"text":"VIPER is built, tested,\nand ready to fly on Blue Origin's second","start":100633,"dur":3737},{"text":"Blue Moon Mark One lander,\nscheduled to launch in late 2027.","start":104370,"dur":3871},{"text":"VIPER very much","start":110210,"dur":1234},{"text":"acts as a scout for Moon Base\nto understand these locations","start":111444,"dur":3170},{"text":"on the South Pole, where they anticipate\nsending more assets, establishing bases.","start":114614,"dur":4605},{"text":"VIPER is currently at the Johnson\nSpace Center in a clean room.","start":119419,"dur":3003},{"text":"It's ready to go.","start":122455,"dur":968},{"text":"It's actually really impressive to see.","start":123423,"dur":2202},{"text":"There's\na lot of people who spent a lot of time","start":125625,"dur":2369},{"text":"making sure every detail is right\nand working,","start":127994,"dur":3036},{"text":"and it's really specific to the job\nit needs to do.","start":131030,"dur":3003},{"text":"VIPER will travel the surface\nfor about 100 days.","start":134367,"dur":3370},{"text":"After we land, we're\ngoing to start a traverse and we go across","start":137737,"dur":3137},{"text":"the different regions\nthat we expect to see water ice.","start":140874,"dur":3503},{"text":"We're always collecting data.","start":144611,"dur":1434},{"text":"The rover’s instruments are always on,\nso we get a lot of statistics as we drive.","start":146045,"dur":3704},{"text":"We'll stop in specific areas\nthat we think there should be","start":149816,"dur":4237},{"text":"a signature of a certain amount\nand do a little more concentrated","start":154053,"dur":3938},{"text":"investigation\nthere and go on to the next one.","start":157991,"dur":3003},{"text":"And then eventually also do this\nin, permanently shadowed region.","start":161060,"dur":3237},{"text":"These regions don't see sun\nfor billions of years.","start":164497,"dur":3037},{"text":"So it’s been cold there for a really,\nreally long time, almost absolute zero.","start":167700,"dur":4071},{"text":"And that is a place\nwhere ice will collect and settle.","start":171905,"dur":3670},{"text":"We cover\na large distance in the first 100 days.","start":177210,"dur":3370}],"analysisVersion":1,"punctuatedByAi":false,"createdAt":0,"updatedAt":0,"sample":{"level":"B2","topic":"月面探査車の計画","reason":"技術的な説明と複数の話し手。自然な速さ（約 180 語/分）","wpm":180,"license":"パブリックドメイン（NASA・米国政府の著作物）","credit":"NASA","sourceUrl":"https://www.youtube.com/watch?v=Zezt6EsG9WE"}}