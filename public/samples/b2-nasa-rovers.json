first rovers to study the lunar surface will be VIPER, a robotic rover designed to search for ice and other resources.","words":[{"w":"One","start":91858,"end":92088},{"w":"of","start":92088,"end":92261},{"w":"NASA's","start":92261,"end":92664},{"w":"first","start":92664,"end":93009},{"w":"rovers","start":93009,"end":93412},{"w":"to","start":93412,"end":93585},{"w":"study","start":93585,"end":93930},{"w":"the","start":93930,"end":94160},{"w":"lunar","start":94160,"end":94505},{"w":"surface","start":94505,"end":94966},{"w":"will","start":94966,"end":95253},{"w":"be","start":95253,"end":95426},{"w":"VIPER,","start":95426,"end":95829},{"w":"a","start":96062,"end":96190},{"w":"robotic","start":96190,"end":96703},{"w":"rover","start":96703,"end":97088},{"w":"designed","start":97088,"end":97665},{"w":"to","start":97665,"end":97858},{"w":"search","start":97858,"end":98306},{"w":"for","start":98306,"end":98563},{"w":"ice","start":98563,"end":98819},{"w":"and","start":98819,"end":99076},{"w":"other","start":99076,"end":99461},{"w":"resources.","start":99461,"end":100166}],"start":91858,"end":100166,"timing":"line","chunks":[0,5,10,13,16,21],"chunksByAi":true,"ja":"月の表面を研究するNASAの最初のローバーの一つは、氷やその他の資源を探すために設計されたVIPERというロボットローバーです。","edge":false,"segFrom":24,"segTo":25},{"id":"s5_100633","text":"VIPER is built, tested, and ready to fly on Blue Origin's second Blue Moon Mark One lander, scheduled to launch in late 2027.","words":[{"w":"VIPER","start":100633,"end":100978},{"w":"is","start":100978,"end":101150},{"w":"built,","start":101150,"end":101553},{"w":"tested,","start":101553,"end":102013},{"w":"and","start":102013,"end":102243},{"w":"ready","start":102243,"end":102588},{"w":"to","start":102588,"end":102760},{"w":"fly","start":102760,"end":102990},{"w":"on","start":102990,"end":103163},{"w":"Blue","start":103163,"end":103450},{"w":"Origin's","start":103450,"end":103968},{"w":"second","start":103968,"end":104370},{"w":"Blue","start":104370,"end":104687},{"w":"Moon","start":104687,"end":105005},{"w":"Mark","start":105005,"end":105322},{"w":"One","start":105322,"end":105576},{"w":"lander,","start":105576,"end":106083},{"w":"scheduled","start":106083,"end":106718},{"w":"to","start":106718,"end":106908},{"w":"launch","start":106908,"end":107353},{"w":"in","start":107353,"end":107543},{"w":"late","start":107543,"end":107860},{"w":"2027.","start":107860,"end":108241}],"start":100633,"end":108241,"timing":"line","chunks":[0,1,3,4,8,17,20],"chunksByAi":true,"ja":"VIPERは、2027年末に打ち上げ予定のブルーオリジンの第二のブルームーンマークワンランダーに搭載され、飛行準備が整っています。","edge":false,"segFrom":26,"segTo":27},{"id":"s6_110210","text":"VIPER very much acts as a scout for Moon Base to understand these locations on the South Pole, where they anticipate sending more assets, establishing bases.","words":[{"w":"VIPER","start":110210,"end":110673},{"w":"very","start":110673,"end":111058},{"w":"much","start":111058,"end":111444},{"w":"acts","start":111444,"end":111708},{"w":"as","start":111708,"end":111867},{"w":"a","start":111867,"end":111972},{"w":"scout","start":111972,"end":112289},{"w":"for","start":112289,"end":112501},{"w":"Moon","start":112501,"end":112765},{"w":"Base","start":112765,"end":113029},{"w":"to","start":113029,"end":113188},{"w":"understand","start":113188,"end":113769},{"w":"these","start":113769,"end":114086},{"w":"locations","start":114086,"end":114614},{"w":"on","start":114614,"end":114782},{"w":"the","start":114782,"end":115007},{"w":"South","start":115007,"end":115344},{"w":"Pole,","start":115344,"end":115681},{"w":"where","start":115681,"end":116018},{"w":"they","start":116018,"end":116299},{"w":"anticipate","start":116299,"end":116917},{"w":"sending","start":116917,"end":117366},{"w":"more","start":117366,"end":117647},{"w":"assets,","start":117647,"end":118096},{"w":"establishing","start":118096,"end":118826},{"w":"bases.","start":118826,"end":119219}],"start":110210,"end":119219,"timing":"line","chunks":[0,1,7,10,14,18,24],"chunksByAi":true,"ja":"VIPERは、南極のこれらの場所を理解するために、月基地の偵察役として非常に大きな役割を果たします。彼らは、より多くの資産を送り、基地を設立することを予想しています。","edge":false,"segFrom":28,"segTo":30},{"id":"s7_119419","text":"VIPER is currently at the Johnson Space Center in a clean room.","words":[{"w":"VIPER","start":119419,"end":119701},{"w":"is","start":119701,"end":119841},{"w":"currently","start":119841,"end":120311},{"w":"at","start":120311,"end":120451},{"w":"the","start":120451,"end":120639},{"w":"Johnson","start":120639,"end":121014},{"w":"Space","start":121014,"end":121296},{"w":"Center","start":121296,"end":121624},{"w":"in","start":121624,"end":121765},{"w":"a","start":121765,"end":121859},{"w":"clean","start":121859,"end":122140},{"w":"room.","start":122140,"end":122422}],"start":119419,"end":122422,"timing":"line","chunks":[0,1,3,8],"chunksByAi":true,"ja":"VIPERは、現在、ジョンソン宇宙センターのクリーンルームにあります。","edge":false,"segFrom":31,"segTo":31},{"id":"s8_122455","text":"It's ready to go.","words":[{"w":"It's","start":122455,"end":122724},{"w":"ready","start":122724,"end":123047},{"w":"to","start":123047,"end":123208},{"w":"go.","start":123208,"end":123423}],"start":122455,"end":123423,"timing":"line","chunks":[0,1],"chunksByAi":true,"ja":"準備ができています。","edge":false,"segFrom":32,"segTo":32},{"id":"s9_123423","text":"It's actually really impressive to see.","words":[{"w":"It's","start":123423,"end":123698},{"w":"actually","start":123698,"end":124194},{"w":"really","start":124194,"end":124579},{"w":"impressive","start":124579,"end":125185},{"w":"to","start":125185,"end":125350},{"w":"see.","start":125350,"end":125625}],"start":123423,"end":125625,"timing":"line","chunks":[0,1,4],"chunksByAi":true,"ja":"実際、見るのは本当に印象的です。","edge":false,"segFrom":33,"segTo":33},{"id":"s10_125625","text":"There's a lot of people who spent a lot of time making sure every detail is right and working, and it's really specific to the job it needs to do.","words":[{"w":"There's","start":125625,"end":126020},{"w":"a","start":126020,"end":126119},{"w":"lot","start":126119,"end":126316},{"w":"o