7},{"w":"one","start":122557,"end":122737},{"w":"of","start":122737,"end":122872},{"w":"the","start":122872,"end":123052},{"w":"payloads","start":123052,"end":123456},{"w":"that","start":123456,"end":123634},{"w":"will","start":123634,"end":123812},{"w":"sit","start":123812,"end":123954},{"w":"on","start":123954,"end":124061},{"w":"the","start":124061,"end":124204},{"w":"top","start":124204,"end":124346},{"w":"deck","start":124346,"end":124524},{"w":"of","start":124524,"end":124631},{"w":"the","start":124631,"end":124773},{"w":"lander.","start":124773,"end":125058}],"start":121254,"end":125058,"timing":"line","chunks":[0,5,10,17],"chunksByAi":true,"ja":"それはランダーの上部デッキに設置されるペイロードによって主に動かされます。","edge":false,"segFrom":37,"segTo":38},{"id":"s15_125058","text":"It's called LuSEE-Night.","words":[{"w":"It's","start":125058,"end":125312},{"w":"called","start":125312,"end":125667},{"w":"LuSEE-Night.","start":125667,"end":126326}],"start":125058,"end":126326,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"それはLuSEE-Nightと呼ばれています。","edge":false,"segFrom":39,"segTo":39},{"id":"s16_126326","text":"So that's a radio astronomy telescope.","words":[{"w":"So","start":126326,"end":126465},{"w":"that's","start":126465,"end":126788},{"w":"a","start":126788,"end":126880},{"w":"radio","start":126880,"end":127158},{"w":"astronomy","start":127158,"end":127620},{"w":"telescope.","start":127620,"end":128128}],"start":126326,"end":128128,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"それはラジオ天文学の望遠鏡です。","edge":false,"segFrom":40,"segTo":40},{"id":"s17_128128","text":"So they want to sit on the far side of the Moon, away from all the noise from Earth so the Moon is kind of blocking all of that.","words":[{"w":"So","start":128128,"end":128228},{"w":"they","start":128228,"end":128395},{"w":"want","start":128395,"end":128562},{"w":"to","start":128562,"end":128662},{"w":"sit","start":128662,"end":128795},{"w":"on","start":128795,"end":128895},{"w":"the","start":128895,"end":129029},{"w":"far","start":129029,"end":129162},{"w":"side","start":129162,"end":129403},{"w":"of","start":129403,"end":129547},{"w":"the","start":129547,"end":129740},{"w":"Moon,","start":129740,"end":130029},{"w":"away","start":130029,"end":130254},{"w":"from","start":130254,"end":130480},{"w":"all","start":130480,"end":130660},{"w":"the","start":130660,"end":130840},{"w":"noise","start":130840,"end":131110},{"w":"from","start":131110,"end":131335},{"w":"Earth","start":131335,"end":131606},{"w":"so","start":131606,"end":131741},{"w":"the","start":131741,"end":131921},{"w":"Moon","start":131921,"end":132146},{"w":"is","start":132146,"end":132282},{"w":"kind","start":132282,"end":132507},{"w":"of","start":132507,"end":132642},{"w":"blocking","start":132642,"end":133047},{"w":"all","start":133047,"end":133228},{"w":"of","start":133228,"end":133363},{"w":"that.","start":133363,"end":133633}],"start":128128,"end":133633,"timing":"line","chunks":[0,3,12,19,26],"chunksByAi":true,"ja":"彼らは月の裏側に座りたいのです、地球からのすべてのノイズから離れて、月がそれをすべて遮るように。","edge":false,"segFrom":41,"segTo":43},{"id":"s18_133867","text":"And they're looking back at the cosmic dark ages.","words":[{"w":"And","start":133867,"end":134030},{"w":"they're","start":134030,"end":134355},{"w":"looking","start":134355,"end":134681},{"w":"back","start":134681,"end":134885},{"w":"at","start":134885,"end":135007},{"w":"the","start":135007,"end":135169},{"w":"cosmic","start":135169,"end":135454},{"w":"dark","start":135454,"end":135658},{"w":"ages.","start":135658,"end":135902}],"start":133867,"end":135902,"timing":"line","chunks":[0,2,4,7],"chunksByAi":true,"ja":"彼らは宇宙の暗黒時代を見つめている","edge":false,"segFrom":44,"segTo":44},{"id":"s19_135902","text":"So that's a very amazing payload.","words":[{"w":"So","start":135902,"end":136173},{"w":"that's","start":136173,"end":136805},{"w":"a","start":136805,"end":136986},{"w":"very","start":136986,"end":137437},{"w":"amazing","start":137437,"end":138159},{"w":"payload.","start":138159,"end":138972}],