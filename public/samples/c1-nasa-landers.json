t right here is like you mentioned our Blue Ghost Mission 2 lunar lander.","words":[{"w":"So","start":107740,"end":107879},{"w":"what","start":107879,"end":108111},{"w":"we're","start":108111,"end":108389},{"w":"looking","start":108389,"end":108760},{"w":"at","start":108760,"end":108899},{"w":"right","start":108899,"end":109177},{"w":"here","start":109177,"end":109409},{"w":"is","start":109409,"end":109557},{"w":"like","start":109557,"end":109803},{"w":"you","start":109803,"end":110000},{"w":"mentioned","start":110000,"end":110492},{"w":"our","start":110492,"end":110689},{"w":"Blue","start":110689,"end":110935},{"w":"Ghost","start":110935,"end":111230},{"w":"Mission","start":111230,"end":111624},{"w":"2","start":111624,"end":111723},{"w":"lunar","start":111723,"end":112018},{"w":"lander.","start":112018,"end":112412}],"start":107740,"end":112412,"timing":"line","chunks":[0,5,8,11,16],"chunksByAi":true,"ja":"今ここで見ているのは、あなたが言ったように、ブルー・ゴーストミッション2号の月着陸機です。","edge":false,"segFrom":31,"segTo":32},{"id":"s10_112745","text":"The lander is now stacked.","words":[{"w":"The","start":112745,"end":112871},{"w":"lander","start":112871,"end":113091},{"w":"is","start":113091,"end":113186},{"w":"now","start":113186,"end":113312},{"w":"stacked.","start":113312,"end":113595}],"start":112745,"end":113595,"timing":"estimated","chunks":[0,2],"chunksByAi":true,"ja":"着陸機は今積み重ねられています。","edge":false,"segFrom":33,"segTo":33},{"id":"s11_113595","text":"It’s starting to really look like a lander.","words":[{"w":"It’s","start":113595,"end":113753},{"w":"starting","start":113753,"end":114036},{"w":"to","start":114036,"end":114131},{"w":"really","start":114131,"end":114351},{"w":"look","start":114351,"end":114509},{"w":"like","start":114509,"end":114666},{"w":"a","start":114666,"end":114729},{"w":"lander.","start":114729,"end":114981}],"start":113595,"end":114981,"timing":"estimated","chunks":[0,5],"chunksByAi":true,"ja":"本当に着陸機らしくなってきました。","edge":false,"segFrom":33,"segTo":33},{"id":"s12_114981",