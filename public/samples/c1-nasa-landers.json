{"id":"sample_c1-nasa-landers","videoId":"Sempwv5MPMQ","title":"NASA Moon Base: Lunar Landers (August 2026 Update)","author":"NASA","videoDuration":615000,"lang":"en","transcriptHash":"4acee2cbb7cfe8ad2c4de3cf51ad9051","source":"supadata","start":60000,"end":180000,"sentences":[{"id":"s0_60927","text":"Now.","words":[{"w":"Now.","start":60927,"end":61213}],"start":60927,"end":61213,"timing":"estimated","chunks":[0],"chunksByAi":true,"ja":"今","edge":false,"segFrom":17,"segTo":17},{"id":"s1_61213","text":"Building a Moon Base won't happen all at once.","words":[{"w":"Building","start":61213,"end":61727},{"w":"a","start":61727,"end":61841},{"w":"Moon","start":61841,"end":62126},{"w":"Base","start":62126,"end":62412},{"w":"won't","start":62412,"end":62755},{"w":"happen","start":62755,"end":63155},{"w":"all","start":63155,"end":63383},{"w":"at","start":63383,"end":63554},{"w":"once.","start":63554,"end":63897}],"start":61213,"end":63897,"timing":"estimated","chunks":[0,4,6],"chunksByAi":true,"ja":"月面基地の建設は一気に行われないでしょう","edge":false,"segFrom":17,"segTo":17},{"id":"s2_63897","text":"It will take more than 20 lunar landings during the first phase, with each mission delivering the equipment, technology, and science needed to build, learn, and improve.","words":[{"w":"It","start":63897,"end":64069},{"w":"will","start":64069,"end":64357},{"w":"take","start":64357,"end":64644},{"w":"more","start":64644,"end":64932},{"w":"than","start":64932,"end":65219},{"w":"20","start":65219,"end":65392},{"w":"lunar","start":65392,"end":65737},{"w":"landings","start":65737,"end":66254},{"w":"during","start":66254,"end":66657},{"w":"the","start":66657,"end":66887},{"w":"first","start":66887,"end":67232},{"w":"phase,","start":67232,"end":67634},{"w":"with","start":67867,"end":68186},{"w":"each","start":68186,"end":68505},{"w":"mission","start":68505,"end":69015},{"w":"delivering","start":69015,"end":69716},{"w":"the","start":69716,"end":69971},{"w":"equipment,","start":69971,"end":70673},{"w":"technology,","start":70673,"end":71438},{"w":"and","start":71438,"end":71740},{"w":"science","start":71740,"end":72345},{"w":"needed","start":72345,"end":72874},{"w":"to","start":72874,"end":73101},{"w":"build,","start":73101,"end":73630},{"w":"learn,","start":73630,"end":74159},{"w":"and","start":74159,"end":74461},{"w":"improve.","start":74461,"end":75141}],"start":63897,"end":75141,"timing":"line","chunks":[0,3,8,12,16,18,19,22,24,25],"chunksByAi":true,"ja":"最初の段階で20回以上の月着陸が必要になるでしょう。各ミッションは、建設、学習、改善に必要な機器、技術、科学を届けます。","edge":false,"segFrom":18,"segTo":20},{"id":"s3_75642","text":"We're traveling across the country to meet the companies building lunar landers for upcoming flights and see how they're preparing for their next missions to the Moon.","words":[{"w":"We're","start":75642,"end":75939},{"w":"traveling","start":75939,"end":76435},{"w":"across","start":76435,"end":76782},{"w":"the","start":76782,"end":76980},{"w":"country","start":76980,"end":77377},{"w":"to","start":77377,"end":77545},{"w":"meet","start":77545,"end":77826},{"w":"the","start":77826,"end":78050},{"w":"companies","start":78050,"end":78612},{"w":"building","start":78612,"end":79117},{"w":"lunar","start":79117,"end":79453},{"w":"landers","start":79453,"end":79902},{"w":"for","start":79902,"end":80127},{"w":"upcoming","start":80127,"end":80632},{"w":"flights","start":80632,"end":81081},{"w":"and","start":81181,"end":81400},{"w":"see","start":81400,"end":81619},{"w":"how","start":81619,"end":81838},{"w":"they're","start":81838,"end":82277},{"w":"preparing","start":82277,"end":82824},{"w":"for","start":82824,"end":83043},{"w":"their","start":83043,"end":83372},{"w":"next","start":83372,"end":83646},{"w":"missions","start":83646,"end":84139},{"w":"to","start":84139,"end":84303},{"w":"the","start":84303,"end":84522},{"w":"Moon.","start":84522,"end":84851}],"start":75642,"end":84851,"timing":"line","chunks":[0,2,5,7,12,15,17,20,24],"chunksByAi":true,"ja":"私たちは、今後の飛行のために月着陸船を建設している企業と会うために国中を旅しています。そして、彼らが次の月へのミッションに向けてどのように準備しているかを見ています。","edge":false,"segFrom":21,"segTo":23},{"id":"s4_87187","text":"Just north of Austin, Texas, Firefly Aerospace is preparing for its second mission to the Moon.","words":[{"w":"Just","start":87187,"end":87469},{"w":"north","start":87469,"end":87807},{"w":"of","start":87807,"end":87976},{"w":"Austin,","start":87976,"end":88427},{"w":"Texas,","start":88427,"end":88822},{"w":"Firefly","start":88822,"end":89300},{"w":"Aerospace","start":89300,"end":89898},{"w":"is","start":89898,"end":90077},{"w":"preparing","start":90077,"end":90675},{"w":"for","start":90675,"end":90914},{"w":"its","start":90914,"end":91153},{"w":"second","start":91153,"end":91571},{"w":"mission","start":91571,"end":92049},{"w":"to","start":92049,"end":92228},{"w":"the","start":92228,"end":92467},{"w":"Moon.","start":92467,"end":92826}],"start":87187,"end":92826,"timing":"line","chunks":[0,4,5,7,9,13],"chunksByAi":true,"ja":"テキサス州オースティンの北、Firefly Aerospaceは月への二度目のミッションに向けて準備を進めています。","edge":false,"segFrom":24,"segTo":25},{"id":"s5_92926","text":"NASA's Carlos García-Galán is taking us inside its headquarters, where engineers are preparing the lunar lander for its upcoming mission.","words":[{"w":"NASA's","start":92926,"end":93372},{"w":"Carlos","start":93372,"end":93817},{"w":"García-Galán","start":93817,"end":94644},{"w":"is","start":94644,"end":94835},{"w":"taking","start":94835,"end":95281},{"w":"us","start":95281,"end":95472},{"w":"inside","start":95472,"end":95917},{"w":"its","start":95917,"end":96172},{"w":"headquarters,","start":96172,"end":97063},{"w":"where","start":97063,"end":97395},{"w":"engineers","start":97395,"end":97948},{"w":"are","start":97948,"end":98169},{"w":"preparing","start":98169,"end":98722},{"w":"the","start":98722,"end":98944},{"w":"lunar","start":98944,"end":99276},{"w":"lander","start":99276,"end":99663},{"w":"for","start":99663,"end":99884},{"w":"its","start":99884,"end":100105},{"w":"upcoming","start":100105,"end":100603},{"w":"miss