g","start":155620,"end":155980},{"w":"to","start":155980,"end":156161},{"w":"gather","start":156161,"end":156582},{"w":"science,","start":156582,"end":157123},{"w":"technology,","start":157123,"end":157443},{"w":"data","start":157443,"end":157577},{"w":"and","start":157577,"end":157684},{"w":"it","start":157684,"end":157764},{"w":"can","start":157764,"end":157871},{"w":"all","start":157871,"end":157977},{"w":"be","start":157977,"end":158058},{"w":"used","start":158058,"end":158191},{"w":"on","start":158191,"end":158271},{"w":"future","start":158271,"end":158458},{"w":"missions.","start":158458,"end":158725}],"start":152252,"end":158725,"timing":"line","chunks":[0,1,4,7,9,14,17,23],"chunksByAi":true,"ja":"だから、それら全てが私たちと一緒に来るのです。それぞれが科学、技術、データを収集し、将来のミッションに使うことができます。","edge":false,"segFrom":53,"segTo":54},{"id":"s28_159826","text":"A lot of the people that worked on mission one are still here working on mission two.","words":[{"w":"A","start":159826,"end":159885},{"w":"lot","start":159885,"end":160003},{"w":"of","start":160003,"end":160091},{"w":"the","start":160091,"end":160209},{"w":"people","start":160209,"end":160416},{"w":"that","start":160416,"end":160563},{"w":"worked","start":160563,"end":160770},{"w":"on","start":160770,"end":160858},{"w":"mission","start":160858,"end":161094},{"w":"one","start":161094,"end":161274},{"w":"are","start":161274,"end":161454},{"w":"still","start":161454,"end":161724},{"w":"here","start":161724,"end":161949},{"w":"working","start":161949,"end":162309},{"w":"on","start":162309,"end":162444},{"w":"mission","start":162444,"end":162804},{"w":"two.","start":162804,"end":163029}],"start":159826,"end":163029,"timing":"line","chunks":[0,5,10,13],"chunksByAi":true,"ja":"ミッション1に携わった多くの人々が、ミッション2にもまだここにいて働いています。","edge":false,"segFrom":55,"segTo":56},{"id":"s29_163029","text":"So we have all that knowledge still in-house.","words":[{"w":"So","start":163029,"end":163181},{"w":"we","start":163181,"end":163334},{"w":"have","start":163334,"end":163588},{"w":"all","start":163588,"end":163791},{"w":"that","start":163791,"end":164045},{"w":"knowledge","start":164045,"end":164552},{"w":"still","start":164552,"end":164857},{"w":"in-house.","start":164857,"end":165365}],"start":163029,"end":165365,"timing":"line","chunks":[0,1,6],"chunksByAi":true,"ja":"だから、その知識はまだ社内にあります。","edge":false,"segFrom":57,"segTo":57},{"id":"s30_165365","text":"And then you're implementing all the lessons learned because we have all that great data from Blue Ghost Mission 1.","words":[{"w":"And","start":165365,"end":165471},{"w":"then","start":165471,"end":165603},{"w":"you're","start":165603,"end":165788},{"w":"implementing","start":165788,"end":166132},{"w":"all","start":166132,"end":166332},{"w":"the","start":166332,"end":166532},{"w":"lessons","start":166532,"end":166933},{"w":"learned","start":166933,"end":167333},{"w":"because","start":167333,"end":167734},{"w":"we","start":167734,"end":167884},{"w":"have","start":167884,"end":168134},{"w":"all","start":168134,"end":168334},{"w":"that","start":168334,"end":168584},{"w":"great","start":168584,"end":168885},{"w":"data","start":168885,"end":169135},{"w":"from","start":169169,"end":169316},{"w":"Blue","start":169316,"end":169463},{"w":"Ghost","start":169463,"end":169640},{"w":"Mission","start":169640,"end":169875},{"w":"1.","start":169875,"end":169964}],"start":165365,"end":169964,"timing":"estimated","chunks":[0,1,4,8,11,15],"chunksByAi":true,"ja":"そして、ブルー・ゴースト・ミッション1からの素晴らしいデータを持っているので、学んだ教訓を全て実装しています。","edge":false,"segFrom":58,"segTo":60},{"id":"s31_169964","text":"So it does feel easier.","words":[{"w":"So","start":169964,"end":170052},{"w":"it","start":170052,"end":170140},{"w":"does","start":170140,"end":170287},{"w":"feel","start":170287,"end":170435},{"w":"easier.","start":170435,"end":170670}],"start":169964,"end":170670,"timing":"estimated","chunks":[0,1,4],"chunksByAi":true,"ja":"だから、簡単に感じます。","edge":false,"segFrom":60,"segTo":60},{"id":"s32_170670","text":"So it feels like the wheel is starting to really turn a lot faster.","words":[{"w":"So","start":170670,"end":170800},{"w":"it","start":170800,"end":170929},{"w":"feels","start":170929,"end":171188},{"w":"like","start":171188,"end":171404},{"w":"the","start":171404,"end":171577},{"w":"wheel","start":171577,"end":171836},{"w":"is","start":171836,"end":171965},{"w":"starting","start":171965,"end":172354},{"w":"to","start":172354,"end":172483},{"w":"really","start":172483,"end":172786},{"w":"turn","start":172786,"end":173002},{"w":"a","start":173002,"end":173088},{"w":"lot","start":173088,"end":173261},{"w":"faster.","start":173261,"end":173606}],"start":170670,"end":173606,"timing":"line","chunks":[0,1,4,8,11],"chunksByAi":true,"ja":"だから車輪が本当に速く回り始めているような気がする","edge":false,"segFrom":61,"segTo":61},{"id":"s33_173606","text":"And then we've got these other Moon Base awards.","words":[{"w":"And","start":173606,"end":173748},{"w":"then","start":173748,"end":173925},{"w":"we've","start":173925,"end":174137},{"w":"got","start":174137,"end":174279},{"w":"these","start":174279,"end":174491},{"w":"other","start":174491,"end":174704},{"w":"Moon","start":174704,"end":174881},{"w":"Base","start":174881,"end":175058},{"w":"awards.","start":175058,"end":175341}],"start":173606,"end":175341,"timing":"line","chunks":[0,2,4],"chunksByAi":true,"ja":"そして他にもムーンベース賞があります","edge":false,"segFrom":62,"segTo":62},{"id":"s34_175341","text":"So it's really about can you make it repeatable can you produce it.","words":[{"w":"So","start":175341,"end":175454},{"w":"it's","start":175454,"end":175643},{"w":"really","start":175643,"end":175908},{"w":"about","start":175908,"end":176135},{"w":"can","start":176135,"end":176286},{"w":"you","start":176286,"end":176437},{"w":"make","start":176437,"end":176626},{"w":"it","start":176626,"end":176739},{"w":"repeatable","start":176739,"end":177155},{"w":"can","start":177155,"end":177306},{"w":"you","start":177306,"end":177457},{"w":"produce","start":177457,"end":177760},{"w":"it.","start":177760,"end":177911}],"start":175341,"end":177911,"timing":"line","chunks":[0,1,4,9],"chunksByAi":true,"ja":"だから本当に繰り返せるか、生産できるかということです","edge":false,"segFrom":63,"segTo":63},{"id":"s35_177911","text":"Yeah.","words":[{"w":"Yeah.","start":177911,"end":178172}],"start":177911,"end":178172,"timing":"estimated","chunks":[0],"chunksByAi":true,"ja":"はい。","edge":false,"segFrom":64,"segTo":64},{"id":"s36_178172","text":"Can you be successful several times.","words":[{"w":"Can","start":178172,"end":178345},{"w":"you","start":178345,"end":178519},{"w":"be","start":178519,"end":178650},{"w":"successful","start":178650,"end":179127},{"w":"several","start":179127,"end":179475},{"w":"times.","start":179475,"end":179779}],"start":178172,"end":179779,"timing":"estimated","chunks":[0,4],"chunksByAi":true,"ja":"何度も成功できるか","edge":false,"segFrom":64,"segTo":64}],"segments":[{"text":"will live, work, and conduct science on\nand around the Moon.","start":56956,"dur":3437},{"text":"Now. Building a Moon Base\nwon't happen all at once.","start":60927,"dur":2970},{"text":"It will take more than 20 lunar landings\nduring the first phase,","start":63897,"dur":3737},{"text":"with each mission\ndelivering the equipment, technology,","start":67867,"dur":3571},{"text":"and science needed to build, learn,\nand improve.","start":71438,"dur":3703},{"text":"We're traveling across the country","start":75642,"dur":1735},{"text":"to meet the companies building\nlunar landers for upcoming flights","start":77377,"dur":3704},{"text":"and see how they're preparing\nfor their next missions to the Moon.","start":81181,"dur":3670},{"text":"Just north of Austin, Texas,","start":87187,"dur":1635},{"text":"Firefly Aerospace is preparing\nfor its second mission to the Moon.","start":88822,"dur":4004},{"text":"NASA's Carlos García-Galán\nis taking us inside its headquarters,","start":92926,"dur":4137},{"text":"where engineers are preparing\nthe lunar lander for its upcoming mission.","start":97063,"dur":4038},{"text":"Love to see the hardware\nready for Moon Base mission Blue Ghost 2.","start":101201,"dur":3570},{"text":"So tell us a little bit\nabout what we're looking at.","start":105238,"dur":2202},{"text":"Yeah.","start":107440,"dur":300},{"text":"So what we're looking at right here","start":107740,"dur":1669},{"text":"is like you mentioned our Blue\nGhost Mission 2 lunar lander.","start":109409,"dur":3003},{"text":"The lander is now stacked. It’s\nstarting to really look like a lander.","start":112745,"dur":2236},{"text":"And we're getting ready to install\nour electronics and all our payloads.","start":114981,"dur":3070},{"text":"Blue Ghost Mission 2","start":118284,"dur":901},{"text":"the lander is going to the far\nside of the Moon,","start":119185,"dur":2069},{"text":"and that is really driven\nby one of the payloads","start":121254,"dur":2202},{"text":"that will sit on the top\ndeck of the lander.","start":123456,"dur":1602},{"text":"It's called LuSEE-Night.","start":125058,"dur":1268},{"text":"So that's a radio astronomy telescope.","start":126326,"dur":1802},{"text":"So they want to sit on the far","start":128128,"dur":1034},{"text":"side of the Moon,","start":129162,"dur":867},{"text":"away from all the noise from Earth so\nthe Moon is kind of blocking all of that.","start":130029,"dur":3604},{"text":"And they're looking back\nat the cosmic dark ages.","start":133867,"dur":2035},{"text":"So that's a very amazing payload.","start":135902,"dur":3070},{"text":"Yeah.","start":138972,"dur":767},{"text":"We will also have another payload\nthat we will, put into orbit.","start":139739,"dur":3771},{"text":"So it'll be in orbit around the Moon.","start":143510,"dur":1801},{"text":"So that's Lunar Pathfinder.","start":145311,"dur":1669},{"text":"We have a rover on board.","start":146980,"dur":2135},{"text":"Yeah.","start":149115,"dur":300},{"text":"So that will be our first mobility payload\nthat we have.","start":149415,"dur":2837},{"text":"So all of those are coming along with us.,\nThey’re each going to gather science,","start":152252,"dur":4871},{"text":"technology, data\nand it can all be used on future missions.","start":157123,"dur":1602},{"text":"A lot of the people that worked on mission","start":159826,"dur":1268},{"text":"one are still here working on mission two.","start":161094,"dur":1935},{"text":"So we have all that knowledge\nstill in-house.","start":163029,"dur":2336},{"text":"And then you're implementing","start":165365,"dur":767},{"text":"all the lessons learned\nbecause we have all that great data","start":166132,"dur":3003},{"text":"from Blue Ghost Mission\n1. So it does feel easier.","start":169169,"dur":1501},{"text":"So it feels like the wheel is starting\nto really turn a lot faster.","start":170670,"dur":2936},{"text":"And then we've got these other Moon\nBase awards.","start":173606,"dur":1735},{"text":"So it's really about can you make it\nrepeatable can you produce it.","start":175341,"dur":2570},{"text":"Yeah. Can you be successful several times.","start":177911,"dur":1868},{"text":"Is the excitement building up?","start":179779,"dur":1268}],"analysisVersion":1,"punctuatedByAi":false,"createdAt":0,"updatedAt":0,"sample":{"level":"C1","topic":"月面着陸船の計画（最新情報）","reason":"1 文が長く情報量が多い技術ナレーション。速い（約 221 語/分）","wpm":221,"license":"パブリックドメイン（NASA・米国政府の著作物）","credit":"NASA","sourceUrl":"https://www.youtube.com/watch?v=Sempwv5MPMQ"}}