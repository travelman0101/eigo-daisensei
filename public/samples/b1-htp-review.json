{"id":"sample_b1-htp-review","videoId":"QI_aKxyAhmo","title":"How to Pronounce: Using What You Have Learned, Part 1","author":"VOA Learning English","videoDuration":115000,"lang":"en","transcriptHash":"dcdf0320191e4b0d466c2846bd379e88","source":"supadata","start":0,"end":114000,"sentences":[{"id":"s0_3236","text":"Hello.","words":[{"w":"Hello.","start":3236,"end":3970}],"start":3236,"end":3970,"timing":"line","chunks":[0],"chunksByAi":true,"ja":"こんにちは","edge":false,"segFrom":0,"segTo":0},{"id":"s1_3970","text":"I'm John Russell.","words":[{"w":"I'm","start":3970,"end":4318},{"w":"John","start":4318,"end":4754},{"w":"Russell.","start":4754,"end":5538}],"start":3970,"end":5538,"timing":"line","chunks":[0,1],"chunksByAi":true,"ja":"私はジョン・ラッセルです","edge":false,"segFrom":1,"segTo":1},{"id":"s2_5538","text":"Let's continue our exploration of common words, phrases and questions in American English.","words":[{"w":"Let's","start":5538,"end":5918},{"w":"continue","start":5918,"end":6487},{"w":"our","start":6487,"end":6740},{"w":"exploration","start":6740,"end":7499},{"w":"of","start":7499,"end":7689},{"w":"common","start":7689,"end":8132},{"w":"words,","start":8132,"end":8575},{"w":"phrases","start":8575,"end":9140},{"w":"and","start":9140,"end":9422},{"w":"questions","start":9422,"end":10128},{"w":"in","start":10128,"end":10340},{"w":"American","start":10340,"end":10976},{"w":"English.","start":10976,"end":11611}],"start":5538,"end":11611,"timing":"line","chunks":[0,1,4,8,10],"chunksByAi":true,"ja":"アメリカ英語の一般的な言葉、フレーズ、質問の探求を続けましょう","edge":false,"segFrom":2,"segTo":3},{"id":"s3_12379","text":"In recent lessons, we have been exploring how to give directions.","words":[{"w":"In","start":12379,"end":12570},{"w":"recent","start":12570,"end":13016},{"w":"lessons,","start":13016,"end":13589},{"w":"we","start":13589,"end":13780},{"w":"have","start":13780,"end":14099},{"w":"been","start":14099,"end":14417},{"w":"exploring","start":14417,"end":15054},{"w":"how","start":15054,"end":15309},{"w":"to","start":15309,"end":15500},{"w":"give","start":15500,"end":15819},{"w":"directions.","start":15819,"end":16583}],"start":12379,"end":16583,"timing":"line","chunks":[0,3,7],"chunksByAi":true,"ja":"最近のレッスンで、私たちは方向を教える方法を探求してきました","edge":false,"segFrom":4,"segTo":4},{"id":"s4_17617","text":"We have learned how to ask about different locations, how to tell people to turn, and how to tell people to continue in the same direction.","words":[{"w":"We","start":17617,"end":17784},{"w":"have","start":17784,"end":18062},{"w":"learned","start":18062,"end":18507},{"w":"how","start":18507,"end":18729},{"w":"to","start":18729,"end":18896},{"w":"ask","start":18896,"end":19119},{"w":"about","start":19119,"end":19452},{"w":"different","start":19452,"end":20008},{"w":"locations,","start":20008,"end":20620},{"w":"how","start":21021,"end":21273},{"w":"to","start":21273,"end":21462},{"w":"tell","start":21462,"end":21777},{"w":"people","start":21777,"end":22218},{"w":"to","start":22218,"end":22407},{"w":"turn,","start":22407,"end":22785},{"w":"and","start":22785,"end":23038},{"w":"how","start":23038,"end":23290},{"w":"to","start":23290,"end":23479},{"w":"tell","start":23479,"end":23794},{"w":"people","start":23794,"end":24235},{"w":"to","start":24235,"end":24424},{"w":"continue","start":24424,"end":24991},{"w":"in","start":25125,"end":25486},{"w":"the","start":25486,"end":25968},{"w":"same","start":25968,"end":26570},{"w":"direction.","start":26570,"end":27894}],"start":17617,"end":27894,"timing":"line","chunks":[0,3,9,15,20],"chunksByAi":true,"ja":"私たちは異なる場所について尋ねる方法、人々に曲がるように言う方法、そして同じ方向に進むように言う方法を学びました","edge":false,"segFrom":5,"segTo":7},{"id":"s5_27994","text":"If you haven't watched those lessons, you might want to start with them first.","words":[{"w":"If","start":27994,"end":28171},{"w":"you","start":28171,"end":28406},{"w":"haven't","start":28406,"end":28877},{"w":"watched","start":28877,"end":29347},{"w":"those","start":29347,"end":29700},{"w":"lessons,","start":29700,"end":30230},{"w":"you","start":30530,"end":30904},{"w":"might","start":30904,"end":31466},{"w":"want","start":31466,"end":31934},{"w":"to","start":31934,"end":32215},{"w":"start","start":32215,"end":32776},{"w":"with","start":32776,"end":33244},{"w":"them","start":33244,"end":33712},{"w":"first.","start":33712,"end":34367}],"start":27994,"end":34367,"timing":"line","chunks":[0,4,6,9],"chunksByAi":true,"ja":"もしそのレッスンを見ていないなら、まずそれらから始めたいと思います","edge":false,"segFrom":8,"segTo":9},{"id":"s6_34367","text":"Today, we will practice using what we have learned.","words":[{"w":"Today,","start":34367,"end":34803},{"w":"we","start":34803,"end":34990},{"w":"will","start":34990,"end":35301},{"w":"practice","start":35301,"end":35861},{"w":"using","start":35861,"end":36235},{"w":"what","start":36235,"end":36546},{"w":"we","start":36546,"end":36733},{"w":"have","start":36733,"end":37044},{"w":"learned.","start":37044,"end":37604}],"start":34367,"end":37604,"timing":"line","chunks":[0,1,4],"chunksByAi":true,"ja":"今日は、学んだことを使って練習します。","edge":false,"segFrom":10,"segTo":10},{"id":"s7_38304","text":"You will need a cell phone or computer to record yourself speaking.","words":[{"w":"You","start":38304,"end":38577},{"w":"will","start":38577,"end":38918},{"w":"need","start":38918,"end":39259},{"w":"a","start":39259,"end":39395},{"w":"cell","start":39395,"end":39736},{"w":"phone","start":39736,"end":40146},{"w":"or","start":40146,"end":40350},{"w":"computer","start":40350,"end":40964},{"w":"to","start":40964,"end":41169},{"w":"record","start":41169,"end":41646},{"w":"yourself","start":41646,"end":42260},{"w":"speaking.","start":42260,"end":42942}],"start":38304,"end":42942,"timing":"line","chunks":[0,3,6,8],"chunksByAi":true,"ja":"自分が話すのを録音するために、携帯電話かコンピュータが必要です。","edge":false,"segFrom":11,"segTo":11},{"id":"s8_43610","text":"That way you can compare your speaking to mine.","words":[{"w":"That","start":43610,"end":44010},{"w":"way","start":44010,"end":44329},{"w":"you","start":44329,"end":44649},{"w":"can","start":44649,"end":44969},{"w":"compare","start":44969,"end":45608},{"w":"your","start":45608,"end":46008},{"w":"speaking","start":46008,"end":46728},{"w":"to","start":46728,"end":46967},{"w":"mine.","start":46967,"end":47447}],"start":43610,"end":47447,"timing":"line","chunks":[0,2,5,7],"chunksByAi":true,"ja":"そうすれば、自分の話し方と私の話し方を比べることができます。","edge":false,"segFrom":12,"segTo":12},{"id":"s9_48715","text":"Let's start.","words":[{"w":"Let's","start":48715,"end":49454},{"w":"start.","start":49454,"end":50316}],"start":48715,"end":50316,"timing":"line","chunks":[0],"chunksByAi":true,"ja":"始めましょう。","edge":false,"segFrom":13,"segTo":13},{"id":"s10_50550","text":"I would like you to read the text that you see out loud.","words":[{"w":"I","start":50550,"end":50674},{"w":"would","start":50674,"end":51046},{"w":"like","start":51046,"end":51357},{"w":"you","start":51357,"end":51605},{"w":"to","start":51605,"end":51791},{"w":"read","start":51791,"end":52101},{"w":"the","start":52101,"end":52350},{"w":"text","start":52350,"end":52660},{"w":"that","start":52660,"end":52970},{"w":"you","start":52970,"end":53218},{"w":"see","start":53218,"end":53466},{"w":"out","start":53466,"end":53715},{"w":"loud.","start":53715,"end":54087}],"start":50550,"end":54087,"timing":"line","chunks":[0,3,6,8,11],"chunksByAi":true,"ja":"見えるテキストを声に出して読んでほしいです。","edge":false,"segFrom":14,"segTo":14},{"id":"s11_54721","text":"Record yourself, then listen to me.","words":[{"w":"Record","start":54721,"end":55272},{"w":"yourself,","start":55272,"end":56060},{"w":"then","start":56060,"end":56454},{"w":"listen","start":56454,"end":57006},{"w":"to","start":57006,"end":57242},{"w":"me.","start":57242,"end":57557}],"start":54721,"end":57557,"timing":"line","chunks":[0,2,4],"chunksByAi":true,"ja":"自分を録音してから、私の話を聞いてください。","edge":false,"segFrom":15,"segTo":15},{"id":"s12_57724","text":"Say the text.","words":[{"w":"Say","start":57724,"end":61585},{"w":"the","start":61585,"end":65446},{"w":"text.","start":65446,"end":71237}],"start":57724,"end":71237,"timing":"line","chunks":[0,1],"chunksByAi":true,"ja":"テキストを読んでください","edge":false,"segFrom":16,"segTo":16},{"id":"s13_73640","text":"Excuse me.","words":[{"w":"Excuse","start":73640,"end":74213},{"w":"me.","start":74213,"end":74541}],"start":73640,"end":74541,"timing":"line","chunks":[0,1],"chunksByAi":true,"ja":"すみません","edge":false,"segFrom":17,"segTo":17},{"id":"s14_74541","text":"Do you speak English?","words":[{"w":"Do","start":74541,"end":74951},{"w":"you","start":74951,"end":75497},{"w":"speak","start":75497,"end":76316},{"w":"English?","start":76316,"end":77544}],"start":74541,"end":77544,"timing":"line","chunks":[0,1,3],"chunksByAi":true,"ja":"英語を話しますか","edge":false,"segFrom":18,"segTo":18},{"id":"s15_78678","text":"Where is the train station?","words":[{"w":"Where","start":78678,"end":79400},{"w":"is","start":79400,"end":79761},{"w":"the","start":79761,"end":80243},{"w":"train","start":80243,"end":80965},{"w":"station?","start":80965,"end":82048}],"start":78678,"end":82048,"timing":"line","chunks":[0,1],"chunksByAi":true,"ja":"駅はどこですか","edge":false,"segFrom":19,"segTo":19},{"id":"s16_82549","text":"Could you repeat that, please?","words":[{"w":"Could","start":82549,"end":83040},{"w":"you","start":83040,"end":83367},{"w":"repeat","start":83367,"end":83940},{"w":"that,","start":83940,"end":84431},{"w":"please?","start":84431,"end":85085}],"start":82549,"end":85085,"timing":"line","chunks":[0,1,3],"chunksByAi":true,"ja":"もう一度言っていただけますか","edge":false,"segFrom":20,"segTo":20},{"id":"s17_85085","text":"Thank you.","words":[{"w":"Thank","start":85085,"end":85904},{"w":"you.","start":85904,"end":86586}],"start":85085,"end":86586,"timing":"line","chunks":[0],"chunksByAi":true,"ja":"ありがとう","edge":false,"segFrom":21,"segTo":21},{"id":"s18_87487","text":"When you compare your recording to my speaking, what differences do you notice?","words":[{"w":"When","start":87487,"end":87748},{"w":"you","start":87748,"end":87956},{"w":"compare","start":87956,"end":88373},{"w":"your","start":88373,"end":88634},{"w":"recording","start":88634,"end":89155},{"w":"to","start":89155,"end":89336},{"w":"my","start":89336,"end":89518},{"w":"speaking,","start":89518,"end":90123},{"w":"what","start":90123,"end":90425},{"w":"differences","start":90425,"end":91151},{"w":"do","start":91151,"end":91332},{"w":"you","start":91332,"end":91574},{"w":"notice?","start":91574,"end":92058}],"start":87487,"end":92058,"timing":"line","chunks":[0,3,8],"chunksByAi":true,"ja":"あなたの録音を私の話し方と比べると、どんな違いがわかりますか？","edge":false,"segFrom":22,"segTo":23},{"id":"s19_92692","text":"Do you stress words in the way that I do?","words":[{"w":"Do","start":92692,"end":92852},{"w":"you","start":92852,"end":93065},{"w":"stress","start":93065,"end":93437},{"w":"words","start":93437,"end":93757},{"w":"in","start":93757,"end":93916},{"w":"the","start":93916,"end":94129},{"w":"way","start":94129,"end":94342},{"w":"that","start":94342,"end":94609},{"w":"I","start":94609,"end":94715},{"w":"do?","start":94715,"end":94928}],"start":92692,"end":94928,"timing":"line","chunks":[0,4],"chunksByAi":true,"ja":"あなたは私と同じように言葉を強調しますか？","edge":false,"segFrom":24,"segTo":24},{"id":"s20_95495","text":"Do your vowel and consonant sounds match my vowel and consonant sounds.","words":[{"w":"Do","start":95495,"end":95688},{"w":"your","start":95688,"end":96009},{"w":"vowel","start":96009,"end":96395},{"w":"and","start":96395,"end":96652},{"w":"consonant","start":96652,"end":97295},{"w":"sounds","start":97295,"end":97745},{"w":"match","start":97745,"end":98131},{"w":"my","start":98131,"end":98444},{"w":"vowel","start":98444,"end":99070},{"w":"and","start":99070,"end":99488},{"w":"consonant","start":99488,"end":100532},{"w":"sounds.","start":100532,"end":101367}],"start":95495,"end":101367,"timing":"line","chunks":[0,6],"chunksByAi":true,"ja":"あなたの母音と子音の音は、私の母音と子音の音に合っていますか。","edge":false,"segFrom":25,"segTo":26},{"id":"s21_101367","text":"This activity can be difficult, but it is well worth it.","words":[{"w":"This","start":101367,"end":101704},{"w":"activity","start":101704,"end":102310},{"w":"can","start":102310,"end":102579},{"w":"be","start":102579,"end":102781},{"w":"difficult,","start":102781,"end":103522},{"w":"but","start":103522,"end":103791},{"w":"it","start":103791,"end":103993},{"w":"is","start":103993,"end":104195},{"w":"well","start":104195,"end":104532},{"w":"worth","start":104532,"end":104936},{"w":"it.","start":104936,"end":105205}],"start":101367,"end":105205,"timing":"line","chunks":[0,5],"chunksByAi":true,"ja":"この活動は難しいかもしれませんが、とても価値があります。","edge":false,"segFrom":27,"segTo":27},{"id":"s22_105705","text":"It allows you to understand what you need to work on to improve your speaking.","words":[{"w":"It","start":105705,"end":105886},{"w":"allows","start":105886,"end":106309},{"w":"you","start":106309,"end":106551},{"w":"to","start":106551,"end":106732},{"w":"understand","start":106732,"end":107396},{"w":"what","start":107396,"end":107698},{"w":"you","start":107698,"end":107940},{"w":"need","start":107940,"end":108242},{"w":"to","start":108242,"end":108423},{"w":"work","start":108423,"end":108725},{"w":"on","start":108725,"end":108906},{"w":"to","start":108906,"end":109088},{"w":"improve","start":109088,"end":109571},{"w":"your","start":109571,"end":109873},{"w":"speaking.","start":109873,"end":110477}],"start":105705,"end":110477,"timing":"line","chunks":[0,5,11],"chunksByAi":true,"ja":"それはあなたが話す力を向上させるために、何を練習すべきかを理解するのに役立ちます。","edge":false,"segFrom":28,"segTo":28},{"id":"s23_111811","text":"That's all for today.","words":[{"w":"That's","start":111811,"end":112236},{"w":"all","start":112236,"end":112479},{"w":"for","start":112479,"end":112721},{"w":"today.","start":112721,"end":113146}],"start":111811,"end":113146,"timing":"line","chunks":[0,2],"chunksByAi":true,"ja":"今日はこれで終わりです。","edge":false,"segFrom":29,"segTo":29},{"id":"s24_113146","text":"Keep up the good work.","words":[{"w":"Keep","start":11314