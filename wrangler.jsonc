{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eigo-daisensei",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "eigo-daisensei", "database_id": "3d31d429-eac3-4708-af13-8107652c28bc", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "LIMIT_TRANSCRIPTS_PER_DAY": "20",
    "LIMIT_ANALYZE_SECONDS_PER_DAY": "3600",
    "LIMIT_LOOKUPS_PER_DAY": "300",
    "LIMIT_GUEST_LOOKUPS_PER_DAY": "30",
    "BACKUP_QUOTA_BYTES": "20971520",
    "GOOGLE_CLIENT_ID": ""
  },
  "triggers": { "crons": ["30 19 * * *"] },
  "observability": { "enabled": true }
}
